{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Bbambaaamm/herdr/blob/main/docs/contracts/taskgraph-v1.1.schema.json",
  "title": "Herdr TaskGraph planner output v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["envelope", "nodes"],
  "properties": {
    "envelope": { "$ref": "#/$defs/envelope" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/node" }
    }
  },
  "$defs": {
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue", "spec_hash", "graph_version", "created_at", "planner"],
      "properties": {
        "issue": { "type": "string", "minLength": 1, "maxLength": 256 },
        "spec_hash": { "type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$" },
        "graph_version": { "const": "1.1.0" },
        "created_at": { "type": "string", "format": "date-time" },
        "planner": { "type": "string", "minLength": 1, "maxLength": 256 },
        "max_nodes": { "type": "integer", "minimum": 1, "maximum": 256, "default": 256 },
        "max_depth": { "type": "integer", "minimum": 1, "maximum": 16, "default": 16 },
        "max_fanout": { "type": "integer", "minimum": 1, "maximum": 16, "default": 16 },
        "policy_profile": { "type": "string", "minLength": 1, "maxLength": 128, "default": "default" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "parent_id", "type", "role", "objective", "inputs",
        "expected_outputs", "dependencies", "priority", "resource_class",
        "model_policy", "tools", "permissions"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "parent_id": { "type": ["string", "null"], "maxLength": 256 },
        "type": { "type": "string", "minLength": 1, "maxLength": 128 },
        "role": { "type": "string", "minLength": 1, "maxLength": 128 },
        "objective": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "inputs": { "type": "array", "items": { "type": "object" } },
        "expected_outputs": { "type": "array", "items": { "type": "object" } },
        "dependencies": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "priority": { "type": "integer" },
        "resource_class": { "type": "string", "minLength": 1, "maxLength": 128 },
        "model_policy": { "type": "object" },
        "tools": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "permissions": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 86400, "default": 1800 },
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 10, "default": 1 }
      }
    }
  }
}
