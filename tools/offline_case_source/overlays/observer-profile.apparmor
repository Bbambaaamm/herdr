# SOURCE-ONLY request. No activation, no attachment to an untrusted binary.
# The future operator must pin its exact immutable entrypoint and compiled
# bytes. Only that observer may receive the worker's readby permission.
abi <abi/5.0>,
profile herdr-offline-observer-03414499dd0d1986 flags=(attach_disconnected,mediate_deleted) {
  audit deny ptrace (trace, tracedby),
  ptrace (readby) peer=herdr-offline-operator-03414499dd0d1986,
  ptrace (read) peer=herdr189-reference-lifetime,
  ptrace (read) peer=herdr-offline-controller-03414499dd0d1986,
  capability sys_ptrace,
  capability dac_read_search,
  audit deny capability sys_admin,
  audit deny mount,
  audit deny umount,
  audit deny pivot_root,
  audit deny userns,
  audit deny network inet,
  audit deny network inet6,
  audit deny change_profile,

  /opt/agent-platform/herdr-offline-03414499dd0d1986/observer/ r,
  /opt/agent-platform/herdr-offline-03414499dd0d1986/composed-core/ r,
  /opt/agent-platform/herdr-offline-03414499dd0d1986/observer/** rix,
  /opt/herdr/releases/p0-5035d92-test/python/** rmix,
  /opt/agent-platform/herdr-offline-03414499dd0d1986/composed-core/** r,
  /etc/ld.so.cache r,
  /bin/bash r,
  /usr/bin/{python3,python3.14} r,
  /etc/{localtime,hosts,hostname,resolv.conf,nsswitch.conf,passwd,group} r,
  /lib64/ld-linux-x86-64.so.2 rm,
  /lib/x86_64-linux-gnu/ld-linux-x86-64.so.2 rm,
  /usr/lib/x86_64-linux-gnu/{libc.so.6,libm.so.6,libz.so.1,libexpat.so.1,libtinfo.so.6,libtinfo.so.6.6,libpthread.so.0,libdl.so.2,libutil.so.1,librt.so.1,libssl.so.3,libcrypto.so.3} rm,
  /etc/herdr/{worker-confinement.json,worker-profile.apparmor} r,
  /etc/herdr/{host-policy.json,launch-plan-issuer.json} r,
  /etc/herdr/offline-03414499dd0d1986/** r,
  /var/lib/herdr-offline-03414499dd0d1986/{authority.json,state.json} r,
  /var/lib/herdr-offline-controller-03414499dd0d1986/observer-phases/** r,
  /var/lib/herdr-offline-observer-03414499dd0d1986/contexts/** r,
  /run/herdr-offline-03414499dd0d1986/observer.sock rw,
  unix (create) type=seqpacket addr=none,
  unix (bind, listen, accept, send, receive, getopt, setopt) type=seqpacket,
  /sys/fs/cgroup/system.slice/*/{cgroup.procs,cgroup.threads} r,
  /etc/herdr/launch-plans/[0-9a-f]*.json r,
  /sys/kernel/security/apparmor/policy/profiles/ r,
  /sys/kernel/security/apparmor/policy/profiles/*/{name,raw_data} r,
  /proc/[0-9]*/{stat,status,environ,mountinfo,cmdline,cgroup} r,
  /proc/sys/kernel/random/boot_id r,
  /proc/[0-9]*/exe r,
  /proc/[0-9]*/attr/current r,
  /proc/[0-9]*/ns/{mnt,pid,net,user,cgroup,time} r,
  /proc/[0-9]*/task/ r,
  /proc/[0-9]*/task/[0-9]*/children r,
  /proc/[0-9]*/fd/ r,
  /proc/[0-9]*/fd/[0-9]* r,
  /proc/[0-9]*/root/ r,
  # Directory metadata only; regular-file reads still use the exact rules.
  /proc/[0-9]*/root/**/ r,
  /proc/[0-9]*/root/{bin,lib,lib64,usr,etc}/** r,
  /proc/[0-9]*/root/home/agentops/.hermes/ r,
  /proc/[0-9]*/root/home/agentops/.hermes/profiles/ r,
  /proc/[0-9]*/root/home/agentops/.hermes/profiles/*/ r,
  /proc/[0-9]*/root/home/agentops/.hermes/profiles/*/{config.yaml,.env,herdr-sdk-policy.json} r,
  /proc/[0-9]*/root/home/agentops/.hermes/hermes-agent/ r,
  /proc/[0-9]*/root/home/agentops/.hermes/hermes-agent/** r,
  /proc/[0-9]*/root/home/agentops/.local/share/uv/python/cpython-3.11.16-linux-x86_64-gnu/** r,
  /proc/[0-9]*/root/run/herdr-bootstrap/** r,
  /proc/[0-9]*/root/run/herdr/policy-code/** r,
  /proc/[0-9]*/root/run/herdr-policy/grant.bundle.json r,
  /proc/[0-9]*/root/home/agentops/.config/ r,
  /proc/[0-9]*/root/home/agentops/.config/herdr/ r,
  /dev/null rw,
  /dev/pts/[0-9]* r,
  allow signal,
}
