# SOURCE ONLY. Requires separate exact source/compiled approval before use.
abi <abi/5.0>,
profile herdr-offline-prep-03414499dd0d1986 flags=(attach_disconnected,mediate_deleted) {
  capability sys_admin,
  capability setuid,
  capability setgid,
  capability setpcap,
  capability mknod,
  capability kill,
  userns,
  ptrace (read, readby) peer=herdr-offline-prep-03414499dd0d1986,
  ptrace (readby) peer=unconfined,
  ptrace (readby) peer=herdr-offline-operator-03414499dd0d1986,
  audit deny ptrace (trace, tracedby),
  change_profile -> herdr189-reference-lifetime,
  signal (send) peer=herdr189-reference-lifetime,
  signal (send, receive) peer=herdr-offline-prep-03414499dd0d1986,
  audit deny network inet,
  audit deny network inet6,
  /run/herdr-launch-authority/native-fds.sock rw,
  unix (create) type=seqpacket addr=none,
  unix (connect, send, receive, getopt, setopt) type=seqpacket,

  /opt/agent-platform/herdr-offline-03414499dd0d1986/native/ r,
  /opt/agent-platform/herdr-offline-03414499dd0d1986/composed-core/ r,
  /opt/agent-platform/herdr-offline-03414499dd0d1986/native/** rix,
  /opt/agent-platform/herdr-offline-03414499dd0d1986/composed-core/** rix,
  /opt/herdr/releases/p0-5035d92-test/python/** rmix,
  /etc/herdr/{host-policy.json,launch-plan-issuer.json,worker-confinement.json,worker-profile.apparmor} r,
  /etc/herdr/offline-03414499dd0d1986/** r,
  /etc/herdr/launch-plans/[0-9a-f]*.json r,
  /var/lib/herdr-offline-03414499dd0d1986/{authority.json,state.json,used-*.json} r,
  # Real directory fsync is needed for the exclusive consumed prep intent.
  /var/lib/herdr-offline-03414499dd0d1986/ r,
  /var/lib/herdr-offline-03414499dd0d1986/native-prep-intent-*.json rw,
  /var/lib/herdr-offline-observer-03414499dd0d1986/contexts/ r,
  /var/lib/herdr-offline-observer-03414499dd0d1986/contexts/{root,child}.json r,
  /var/lib/herdr-offline-observer-03414499dd0d1986/contexts/child-slot.json r,
  /var/lib/herdr-offline-observer-03414499dd0d1986/contexts/{root,child}.runtime.json rw,
  /var/lib/herdr-offline-observer-03414499dd0d1986/contexts/{root,child}.mount.json rw,
  /sys/kernel/security/apparmor/policy/profiles/ r,
  /sys/kernel/security/apparmor/policy/profiles/*/{name,raw_data} r,
  /proc/[0-9]*/{stat,status,cgroup,mountinfo} r,
  /proc/self/{stat,mountinfo} r,
  /proc/self/ns/{pid,mnt} r,
  /proc/[0-9]*/{uid_map,gid_map,setgroups} rw,
  /proc/[0-9]*/ns/{pid,user,mnt,net} r,
  /proc/[0-9]*/task/ r,
  /proc/[0-9]*/fd/ r,
  /proc/[0-9]*/fd/[0-9]* r,
  /proc/[0-9]*/attr/current rw,
  /proc/sys/kernel/random/boot_id r,
  /sys/fs/cgroup/system.slice/herdr-offline-{root,child}-03414499dd0d1986.service/ r,
  /dev/{null,tty} rw,
  /dev/pts/[0-9]* rw,
  /run/herdr-offline-private-root-[0-9a-f]*/ rw,
  /run/herdr-offline-private-root-[0-9a-f]*/** rw,
  mount options=(rprivate) -> /,
  mount fstype=tmpfs -> /run/herdr-offline-private-root-[0-9a-f]*{,/**},
  mount fstype=proc -> /run/herdr-offline-private-root-[0-9a-f]*/proc/,
  mount fstype=devpts -> /run/herdr-offline-private-root-[0-9a-f]*/dev/pts/,
  mount options=(bind) -> /run/herdr-offline-private-root-[0-9a-f]*/**,
  remount /run/herdr-offline-private-root-[0-9a-f]*{,/**},
  pivot_root /run/herdr-offline-private-root-[0-9a-f]*/,
  umount,
  /bin/bash r,
  /usr/bin/{python3,python3.14} r,
  /lib64/ld-linux-x86-64.so.2 rm,
  /lib/x86_64-linux-gnu/ld-linux-x86-64.so.2 rm,
  /usr/lib/x86_64-linux-gnu/{libc.so.6,libm.so.6,libz.so.1,libexpat.so.1,libtinfo.so.6,libtinfo.so.6.6,libpthread.so.0,libdl.so.2,libutil.so.1,librt.so.1,libssl.so.3,libcrypto.so.3} rm,
  /etc/{ld.so.cache,localtime,hosts,hostname,resolv.conf,nsswitch.conf,passwd,group} r,
}
