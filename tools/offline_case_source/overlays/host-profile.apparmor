# SOURCE ONLY. Trusted host factory, User1001, never the SDK worker domain.
abi <abi/5.0>,
profile herdr-offline-controller-03414499dd0d1986 flags=(attach_disconnected,mediate_deleted) {
  audit deny capability,
  audit deny mount,
  audit deny umount,
  audit deny pivot_root,
  audit deny userns,
  audit deny ptrace (read, trace, tracedby),
  ptrace (readby) peer=herdr-offline-observer-03414499dd0d1986,
  # Existing root issuer reads protected host startup metadata. DAC plus
  # PR_SET_DUMPABLE=0 remains mandatory; this grants no SDK access to the host.
  ptrace (readby) peer=unconfined,
  ptrace (readby) peer=herdr-offline-operator-03414499dd0d1986,
  audit deny change_profile,
  audit deny network inet,
  audit deny network inet6,
  /opt/agent-platform/herdr-offline-03414499dd0d1986/composed-core/** rix,
  /opt/herdr/releases/p0-5035d92-test/python/** rmix,
  # /** grants descendants, not these roots opened for source inventory.
  /opt/agent-platform/herdr-offline-03414499dd0d1986/composed-core/ r,
  /opt/herdr/releases/p0-5035d92-test/python/ r,
  /opt/herdr/releases/p0-5035d92-test/hermes/ r,
  # Original ApprovedImmutableTree inventories the pinned SDK as data.
  /opt/herdr/releases/p0-5035d92-test/hermes/** r,
  /opt/agent-platform/herdr-offline-03414499dd0d1986/native/herdr rix,
  /opt/agent-platform/herdr-offline-03414499dd0d1986/host-profile/** r,
  /etc/herdr/** r,
  /var/lib/herdr-offline-controller-03414499dd0d1986/** rwk,
  /var/lib/herdr-offline-observer-03414499dd0d1986/contexts/** r,
  /home/agentops/tmp/hermes-*/workspace/** rwk,
  /home/agentops/tmp/hermes-*/results/*.result.json rwk,
  /home/agentops/.config/herdr/** rwk,
  /run/herdr-offline-03414499dd0d1986/observer.sock rw,
  /run/herdr-launch-authority/{issuer.sock,native-fds.sock} rw,
  unix (create) type=seqpacket addr=none,
  unix (connect, send, receive, getopt, setopt) type=seqpacket,
  unix (create) type=stream addr=none,
  unix (bind, listen, accept, connect, send, receive, getopt, setopt) type=stream,
  /proc/[0-9]*/{stat,status,cgroup} r,
  /proc/sys/kernel/random/boot_id r,
  /proc/[0-9]*/fd/ r,
  /proc/[0-9]*/fd/[0-9]* r,
  # Nondumpable controller proc entries are root-owned. This is metadata,
  # not FD contents; ptrace(read/trace) remains denied for external targets.
  /proc/[0-9]*/fdinfo/[0-9]* r,
  /dev/{null,tty,ptmx} rw,
  /dev/pts/ptmx rw,
  /usr/bin/{bash,dash,sh} rix,
  /bin/{bash,dash,sh} rix,
  /etc/bash.bashrc r,
  /home/agentops/{.bashrc,.profile} r,
  signal (receive) peer=herdr-offline-operator-03414499dd0d1986,
  signal (receive) peer=unconfined,
  /dev/pts/[0-9]* rw,
  /lib64/ld-linux-x86-64.so.2 rm,
  /lib/x86_64-linux-gnu/ld-linux-x86-64.so.2 rm,
  /usr/lib/x86_64-linux-gnu/{libc.so.6,libm.so.6,libz.so.1,libexpat.so.1,libtinfo.so.6,libtinfo.so.6.6,libpthread.so.0,libdl.so.2,libutil.so.1,librt.so.1,libssl.so.3,libcrypto.so.3} rm,
  /etc/{ld.so.cache,localtime,hosts,hostname,resolv.conf,nsswitch.conf,passwd,group} r,
  signal (send) peer=herdr189-reference-lifetime,
  /opt/agent-platform/herdr-offline-03414499dd0d1986/ r,
  /opt/agent-platform/herdr-offline-03414499dd0d1986/offline_case/ r,
  /opt/agent-platform/herdr-offline-03414499dd0d1986/offline_case/** r,
  /opt/agent-platform/herdr-offline-03414499dd0d1986/accepted-source/ r,
  /opt/agent-platform/herdr-offline-03414499dd0d1986/accepted-source/** r,
  /opt/agent-platform/herdr-offline-03414499dd0d1986/{*.json,core_bridge.py} r,
  /opt/agent-platform/herdr-offline-03414499dd0d1986/overlays/ r,
  /opt/agent-platform/herdr-offline-03414499dd0d1986/overlays/** r,
  /opt/agent-platform/herdr-offline-03414499dd0d1986/units/ r,
  /opt/agent-platform/herdr-offline-03414499dd0d1986/units/* r,
  /opt/agent-platform/herdr-offline-03414499dd0d1986/native/ r,
  /var/lib/agent-platform-herdr/ rwk,
  /var/lib/agent-platform-herdr/** rwk,
  /run/herdr-offline-host-03414499dd0d1986/ rwk,
  /run/herdr-offline-host-03414499dd0d1986/control.sock rwk,
  /run/herdr-policy/** rwk,
  /run/herdr-bootstrap/** rwk,
  /home/agentops/.config/herdr/ rwk,
  /home/agentops/tmp/ r,
  /proc/self/ r,
  /proc/self/** r,
  /proc/[0-9]*/cmdline r,
  /etc/systemd/system/herdr-offline*-03414499dd0d1986.service r,
  /sys/kernel/security/apparmor/policy/profiles/ r,
  /sys/kernel/security/apparmor/policy/profiles/*/ r,
  /sys/kernel/security/apparmor/policy/profiles/*/{name,raw_data} r,
}
