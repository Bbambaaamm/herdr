#!/usr/bin/env python3
"""Fail-closed Herdr CLI boundary inside an Agent Stack durable task pane."""
import os
import sys


def main() -> int:
    real = os.environ.get("HERDR_REAL_BINARY", "")
    if not real or not os.path.isabs(real) or os.path.realpath(real) == os.path.realpath(__file__):
        print("durable task: real Herdr binary is unavailable", file=sys.stderr)
        return 126
    args = sys.argv[1:]
    if os.environ.get("HERDR_DURABLE_SANDBOX") == "1":
        print("durable task: direct Herdr CLI denied; use agent-durable-child", file=sys.stderr)
        return 126
    if os.environ.get("HERDR_DURABLE_TASK_ID"):
        # An unknown command may become a mutation as the CLI evolves.
        allowed = (len(args) >= 2 and (args[0], args[1]) in {
            ("agent", "get"), ("agent", "list"),
            ("pane", "list"), ("pane", "get"), ("pane", "process-info"),
            ("workspace", "list"), ("workspace", "get"),
        }) or args == ["--skill"]
        if not allowed:
            print("durable task: unmanaged Herdr mutation/delegation denied; use agent-durable-child", file=sys.stderr)
            return 126
    os.execv(real, [real, *args])
    return 127


if __name__ == "__main__":
    raise SystemExit(main())
