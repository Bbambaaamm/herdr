#!/usr/bin/env python3
import hashlib
import json
import os
import signal
import socket
import stat
import subprocess
import sys
import tempfile
import time
import uuid
from datetime import datetime, timedelta, timezone
from pathlib import Path
from contextlib import contextmanager

from agent_model_policy import decide as decide_model_route, record as record_model_route
from agent_durable_sandbox import (command as sandbox_command, frozen_policy, inner_pid,
                                   shell_command, verify as verify_sandbox)
from agent_durable_children import parent_attempt_guard

HOME = Path("/home/agentops")
HERDR = HOME / ".local/bin/herdr"
ROOT = HOME / ".local/state/agent-stack/tasks"
PENDING = ROOT / "pending"
RUNNING = ROOT / "running"
DONE = ROOT / "done"
BLOCKED = ROOT / "blocked"
FAILED = ROOT / "failed"
RESULTS = ROOT / "results"
LOGS = ROOT / "logs"
LOCK = ROOT / "worker.lock"

ENV = os.environ.copy()
AGENT_BIN = Path(__file__).resolve().parent
ENV["HOME"] = str(HOME)
ENV["PATH"] = f"{AGENT_BIN}:{HOME}/.local/node24/bin:{HOME}/.local/bin:/usr/local/bin:/usr/bin:/bin"

def utcnow() -> datetime:
    return datetime.now(timezone.utc)

def write_json(path: Path, data: dict) -> None:
    fd, name = tempfile.mkstemp(prefix=path.name + ".", suffix=".tmp", dir=path.parent)
    temporary = Path(name)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(data, handle, ensure_ascii=False, indent=2)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        temporary.unlink(missing_ok=True)


def persist_execution_session(task: dict, *, startup=True) -> None:
    """Publish ownership in the canonical queue BEFORE launching more resources."""
    sidecar = Path(str(task["task_file"]))
    canonical = current_task_path(task)
    if canonical is None:
        canonical = RUNNING / (str(task["id"]) + ".json")
        current = dict(task)
    else:
        current = json.loads(canonical.read_text(encoding="utf-8"))
        for field in ("id", "run_token", "idempotency_key", "attempts"):
            if current.get(field) != task.get(field):
                raise RuntimeError("task_session_canonical_identity_changed")
        if startup and canonical.parent in (DONE, BLOCKED, FAILED):
            raise RuntimeError("task_session_canonical_already_terminal")
    current["execution_session"] = dict(task["execution_session"])
    current["task_file"] = str(sidecar)
    write_json(canonical, current)
    if sidecar != canonical:
        write_json(sidecar, task)

def log(task_id: str, message: str) -> None:
    line = f"{utcnow().isoformat(timespec='seconds')} {message}"
    with (LOGS / f"{task_id}.worker.log").open("a", encoding="utf-8") as handle:
        handle.write(line + "\n")

def move(path: Path, target_dir: Path) -> Path:
    target = target_dir / path.name
    os.replace(path, target)
    return target

def result_path(task_id: str) -> Path:
    return RESULTS / f"{task_id}.json"

def archive_previous_result(task_id: str, attempt: int) -> None:
    rp = result_path(task_id)
    if not rp.exists():
        return
    stamp = utcnow().strftime("%Y%m%dT%H%M%SZ")
    archived = RESULTS / f"{task_id}.attempt{attempt}.previous-{stamp}.json"
    os.replace(rp, archived)
    os.chmod(archived, 0o600)


def prepare_attempt(task: dict) -> None:
    """Allocate one semantic execution attempt; reconciliation reuses it."""
    if task.get("attempt_state") == "delivery_uncertain" and task.get("run_token"):
        return
    if task.get("parent_task_id"):
        if not all(task.get(field) for field in ("run_token", "idempotency_key",
                                                  "fencing_token", "delegation_key")):
            raise RuntimeError("durable_child_admission_identity_missing")
        task["attempt_state"] = "dispatching"
        task.setdefault("attempt_started_at", utcnow().isoformat())
        return
    session = task.get("execution_session")
    if (
        isinstance(session, dict)
        and session.get("owned_pane")
        and not session.get("closed_at")
    ):
        raise RuntimeError("previous_task_session_not_closed")
    attempt = int(task.get("attempts") or 0)
    archive_previous_result(str(task["id"]), attempt)
    task.pop("execution_session", None)
    task["run_token"] = uuid.uuid4().hex
    task["attempt_id"] = attempt
    seed = ":".join(
        (
            str(task["id"]),
            str(attempt),
            str(task.get("graph_hash") or ""),
            str(task.get("spec_hash") or ""),
        )
    )
    task["idempotency_key"] = hashlib.sha256(seed.encode("utf-8")).hexdigest()
    task["delivery_reconcile_count"] = 0
    task["attempt_state"] = "dispatching"
    task["attempt_started_at"] = utcnow().isoformat()

def _parse_herdr_json(proc: subprocess.CompletedProcess[str], context: str) -> dict:
    if proc.returncode != 0:
        raise RuntimeError((proc.stderr or proc.stdout or context).strip())
    text = (proc.stdout or "").strip()
    for line in reversed(text.splitlines()):
        candidate = line.strip()
        if candidate.startswith("{"):
            try:
                payload = json.loads(candidate)
            except json.JSONDecodeError:
                continue
            if isinstance(payload, dict):
                return payload
    raise RuntimeError(f"{context}: no JSON response")


def _herdr_json(args: list[str], *, timeout_seconds: float = 30.0) -> dict:
    proc = subprocess.run(
        [str(HERDR), *args],
        text=True,
        capture_output=True,
        timeout=timeout_seconds,
        env=ENV,
    )
    return _parse_herdr_json(proc, "herdr " + " ".join(args[:2]))


def _task_session_identity(task: dict) -> tuple[str, str]:
    run_token = str(task.get("run_token") or "")
    if not run_token:
        raise RuntimeError("task session requires run_token")
    routing = task.get("routing") if isinstance(task.get("routing"), dict) else {}
    coordinator = str(
        routing.get("selected_agent") or task.get("agent") or "quantlab-hermes"
    )
    digest = hashlib.sha256(
        f"{coordinator}:{task['id']}:{run_token}".encode("utf-8")
    ).hexdigest()
    # Herdr agent names are capped at 32 characters. Keep a readable,
    # coordinator-derived prefix and bind uniqueness to the full coordinator,
    # task id and run token through a 64-bit digest suffix.
    prefix = coordinator[:13].rstrip("-_") or "task"
    agent_name = f"{prefix}-t-{digest[:16]}"
    if len(agent_name) > 32:
        raise RuntimeError("task session agent name exceeds Herdr limit")
    return agent_name, f"durable-{digest[:20]}"


def observe_task_execution(task: dict) -> str:
    """Observe only the pane and agent bound to this exact task/run_token."""
    session = task.get("execution_session")
    state = "unavailable"
    if isinstance(session, dict) and not session.get("closed_at"):
        try:
            expected_agent, expected_session = _task_session_identity(task)
            pane_id = str(session.get("pane_id") or "")
            if (session.get("agent_name") == expected_agent
                    and session.get("session_name") == expected_session
                    and session.get("pane_marker") == expected_session
                    and pane_id and _pane_has_marker(pane_id, expected_session)):
                payload = _herdr_json(["agent", "get", expected_agent], timeout_seconds=10.0)
                agent = (payload.get("result") or {}).get("agent")
                if isinstance(agent, dict) and str(agent.get("pane_id") or "") == pane_id:
                    status = str(agent.get("agent_status") or agent.get("status") or "").lower()
                    state = {"working": "working", "busy": "working",
                             "blocked": "blocked", "done": "settled",
                             "idle": "settled"}.get(status, "unavailable")
        except (OSError, RuntimeError, ValueError, subprocess.SubprocessError):
            pass
    task["observed_execution"] = {
        "state": state, "source": "herdr_agent_get+task_pane_marker",
        "observed_at": utcnow().isoformat(),
        "task_id": str(task.get("id") or ""),
        "run_token": str(task.get("run_token") or ""),
    }
    return state


def _task_hermes_profile(task: dict) -> str:
    explicit = str(task.get("hermes_profile") or "").strip()
    if explicit:
        return explicit
    profile = str(task.get("safety_profile") or "quantlab")
    return "majak" if profile == "dotacni-majak" else "quantlab"


TASK_PANE_ENV = "HERDR_DURABLE_TASK_PANE"
POLICY_BIN = Path(__file__).resolve().parents[1] / "policy-bin"
CHILD_HELPER = Path(__file__).resolve().parent / "agent-durable-child"
BRIDGE = Path(__file__).resolve().parent / "agent-durable-bridge"


def bridge_socket_name(task: dict) -> str:
    digest = hashlib.sha256(f"{task['id']}:{task['run_token']}".encode()).hexdigest()
    return f"@herdr-durable-{digest[:40]}"


def bridge_alive(session: dict) -> bool:
    pid = int(session.get("bridge_pid") or 0)
    task_id = str(session.get("bridge_task_id") or "")
    run_token = str(session.get("bridge_run_token") or "")
    if pid <= 0 or not task_id or not run_token:
        return False
    expected_socket = "@herdr-durable-" + hashlib.sha256(
        f"{task_id}:{run_token}".encode()
    ).hexdigest()[:40]
    try:
        args = [part.decode("utf-8", errors="replace") for part in
                Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0") if part]
        return (
            str(BRIDGE) in args
            and "--task-id" in args
            and args[args.index("--task-id") + 1] == task_id
            and "--run-token" in args
            and args[args.index("--run-token") + 1] == run_token
            and session.get("bridge_socket") == expected_socket
        )
    except (OSError, ValueError, IndexError):
        return False


def start_bridge(task: dict, session: dict) -> None:
    if bridge_alive(session):
        return
    name = bridge_socket_name(task)
    task_file = Path(str(task["task_file"])).resolve()
    args = [sys.executable, str(BRIDGE), "--task-file", str(task_file),
            "--task-id", str(task["id"]), "--run-token", str(task["run_token"]),
            "--agent", session["agent_name"], "--pane", session["pane_id"],
            "--marker", session["pane_marker"], "--real-binary", str(HERDR)]
    log_path = LOGS / f"{task['id']}.bridge.log"
    log_path.parent.mkdir(parents=True, exist_ok=True)
    with log_path.open("a", encoding="utf-8") as output:
        process = subprocess.Popen(args, stdin=subprocess.DEVNULL, stdout=output,
                                   stderr=output, env=ENV, start_new_session=True)
    session["bridge_pid"] = process.pid
    session["bridge_socket"] = name
    session["bridge_task_id"] = str(task["id"])
    session["bridge_run_token"] = str(task["run_token"])
    persist_execution_session(task)
    for _ in range(30):
        if process.poll() is not None:
            break
        try:
            with socket.socket(socket.AF_UNIX) as connection:
                connection.settimeout(0.1)
                connection.connect("\0" + name[1:])
            return
        except OSError:
            time.sleep(0.1)
    raise RuntimeError("durable_bridge_unavailable")


def stop_bridge(session: dict) -> None:
    if bridge_alive(session):
        os.kill(int(session["bridge_pid"]), signal.SIGTERM)


def ensure_parent_scope(task: dict) -> None:
    """Copy only an explicit matching consumer scope into older queued tasks."""
    scope_fields = ("parent_role", "parent_tools", "parent_permissions", "worktree_root")
    if all(field in task for field in scope_fields):
        return
    config = Path(__file__).resolve().parents[1] / "config/github-intake-consumers.json"
    consumers = json.loads(config.read_text(encoding="utf-8"))["consumers"]
    matching = [entry for entry in consumers
                if entry.get("repository") == task.get("repo")
                and entry.get("safety_profile") == task.get("safety_profile")]
    if len(matching) != 1 or not all(field in matching[0] for field in scope_fields):
        return
    for field in scope_fields:
        task.setdefault(field, matching[0][field])


def _pane_has_marker(pane_id: str, marker: str) -> bool:
    info = _herdr_json(
        ["pane", "process-info", "--pane", pane_id], timeout_seconds=10.0
    )
    process_info = (info.get("result") or {}).get("process_info")
    if not isinstance(process_info, dict):
        return False
    try:
        shell_pid = int(process_info.get("shell_pid") or 0)
    except (TypeError, ValueError):
        return False
    if shell_pid <= 0:
        return False
    try:
        environ = Path(f"/proc/{shell_pid}/environ").read_bytes().split(b"\0")
    except OSError:
        return False
    expected = f"{TASK_PANE_ENV}={marker}".encode("utf-8")
    return expected in environ


def _find_marked_task_panes(marker: str, workspace_id: str) -> tuple[str, ...]:
    for attempt in range(3):
        listed = _herdr_json(["pane", "list"], timeout_seconds=10.0)
        panes = (listed.get("result") or {}).get("panes")
        if not isinstance(panes, list):
            raise RuntimeError("task_session_pane_list_invalid")
        found = []
        for pane in panes:
            if not isinstance(pane, dict):
                continue
            pane_id = str(pane.get("pane_id") or "")
            if (
                pane_id
                and str(pane.get("workspace_id") or "") == workspace_id
                and _pane_has_marker(pane_id, marker)
            ):
                found.append(pane_id)
        if found:
            return tuple(sorted(set(found)))
        if attempt < 2:
            time.sleep(0.2)
    return ()


def _close_owned_pane(pane_id: str) -> bool:
    try:
        proc = subprocess.run(
            [str(HERDR), "pane", "close", pane_id],
            text=True,
            capture_output=True,
            timeout=15,
            env=ENV,
        )
    except (OSError, subprocess.SubprocessError):
        return False
    return proc.returncode == 0


def _setup_pane_ids() -> set[str]:
    listed = _herdr_json(["pane", "list"], timeout_seconds=10.0)
    panes = (listed.get("result") or {}).get("panes")
    if not isinstance(panes, list):
        raise RuntimeError("task_session_pane_list_invalid")
    return {str(row.get("pane_id")) for row in panes
            if isinstance(row, dict) and row.get("pane_id")}


def _cleanup_setup_pane(pane_id: str, coordinator_pane: str, marker: str,
                        agent_name: str, agent_start_attempted: bool,
                        preexisting_panes: set[str]) -> bool:
    """Close a setup pane only while its current identity is proven."""
    if not pane_id or pane_id == coordinator_pane or pane_id in preexisting_panes:
        return False
    try:
        listed = _herdr_json(["pane", "list"], timeout_seconds=10.0)
        panes = (listed.get("result") or {}).get("panes")
        if not isinstance(panes, list):
            return False
        if not any(isinstance(row, dict) and str(row.get("pane_id") or "") == pane_id
                   for row in panes):
            return True
        if not marker or not _pane_has_marker(pane_id, marker):
            return False
        if agent_start_attempted:
            live = (_herdr_json(["agent", "get", agent_name], timeout_seconds=10.0)
                    .get("result") or {}).get("agent")
            if (not isinstance(live, dict) or live.get("name") != agent_name
                    or str(live.get("pane_id") or "") != pane_id):
                return False
        return _close_owned_pane(pane_id)
    except (OSError, RuntimeError, ValueError, TypeError, AttributeError):
        return False


def create_task_session(task: dict) -> dict:
    """Create one fresh Hermes pane/session for exactly one durable attempt."""
    routing = task.get("routing") if isinstance(task.get("routing"), dict) else {}
    coordinator = str(
        routing.get("selected_agent") or task.get("agent") or "quantlab-hermes"
    )
    info = _herdr_json(["agent", "get", coordinator], timeout_seconds=15.0)
    agent_info = (info.get("result") or {}).get("agent")
    if not isinstance(agent_info, dict):
        raise RuntimeError("task_session_coordinator_not_found")
    kind = str(agent_info.get("agent") or agent_info.get("kind") or "")
    if kind != "hermes":
        raise RuntimeError(f"task_session_requires_hermes_coordinator:{kind or 'unknown'}")
    coordinator_pane = str(agent_info.get("pane_id") or "")
    if not coordinator_pane:
        raise RuntimeError("task_session_coordinator_pane_missing")

    workspace = str(task.get("workspace") or "/home/agentops/workspaces/quantlab")
    workspace_id = str(agent_info.get("workspace_id") or "")
    if not workspace_id:
        raise RuntimeError("task_session_coordinator_workspace_missing")
    agent_name, session_name = _task_session_identity(task)
    pane_marker = session_name
    task_file = str(task.get("task_file") or RUNNING / f"{task['id']}.json")
    task["task_file"] = task_file
    task_env = {
        TASK_PANE_ENV: pane_marker,
        "HERDR_DURABLE_TASK_ID": str(task["id"]),
        "HERDR_DURABLE_RUN_TOKEN": str(task["run_token"]),
        "HERDR_DURABLE_TASK_FILE": task_file,
        "HERDR_DURABLE_AGENT": agent_name,
        "HERDR_DURABLE_MARKER": pane_marker,
        "HERDR_REAL_BINARY": str(HERDR),
        "HERDR_DURABLE_BRIDGE_SOCKET": bridge_socket_name(task),
        "PATH": f"{POLICY_BIN}:{ENV['PATH']}",
    }
    profile = _task_hermes_profile(task)
    pane_id = ""
    agent_start_attempted = False
    preexisting_panes = _setup_pane_ids()
    try:
        split = _herdr_json(
            [
                "pane", "split", "--pane", coordinator_pane,
                "--direction", "right", "--cwd", workspace,
                *(part for key, value in task_env.items() for part in ("--env", f"{key}={value}")),
                "--no-focus",
            ],
            timeout_seconds=15.0,
        )
        pane = (split.get("result") or {}).get("pane")
        if not isinstance(pane, dict) or not pane.get("pane_id"):
            raise RuntimeError("task_session_pane_split_invalid")
        pane_id = str(pane["pane_id"])
        if pane_id == coordinator_pane:
            raise RuntimeError("task_session_pane_not_isolated")
        if pane_id in preexisting_panes:
            raise RuntimeError("task_session_pane_reused")
        session = {
            "agent_name": agent_name,
            "session_name": session_name,
            "pane_id": pane_id,
            "pane_marker": pane_marker,
            "coordinator_agent": coordinator,
            "coordinator_pane_id": coordinator_pane,
            "profile": profile,
            "owned_pane": True,
            "created_at": utcnow().isoformat(),
        }
        task["execution_session"] = session
        persist_execution_session(task)
        start_bridge(task, session)
        policy = frozen_policy()
        session["policy_file"] = str(policy)
        persist_execution_session(task)
        task_result = result_path(str(task["id"]))
        task_result.parent.mkdir(parents=True, exist_ok=True)
        if not task_result.exists():
            task_result.touch(mode=0o600)
        command = sandbox_command(
            Path(workspace), HERDR, writable=(task_result,), policy=policy
        )
        _herdr_json(["pane", "run", pane_id, shell_command(command)], timeout_seconds=15.0)
        info = _herdr_json(["pane", "process-info", "--pane", pane_id], timeout_seconds=10.0)
        process_info = (info.get("result") or {}).get("process_info")
        sandbox_pid = inner_pid(process_info if isinstance(process_info, dict) else {}, pane_marker)
        if not sandbox_pid or not verify_sandbox(sandbox_pid, HERDR, pane_marker, policy=policy):
            raise RuntimeError("durable_sandbox_unverified")
        session["sandbox_pid"] = sandbox_pid
        session["sandbox_attestation"] = {
            "authority": "agent-task-worker",
            "kind": "bwrap",
            "task_id": str(task["id"]),
            "run_token": str(task["run_token"]),
            "agent_name": agent_name,
            "pane_id": pane_id,
            "marker": pane_marker,
            "sandbox_pid": sandbox_pid,
            "policy_sha256": hashlib.sha256(policy.read_bytes()).hexdigest(),
            "verified_at": utcnow().isoformat(),
        }
        session["sandbox_verified"] = True
        persist_execution_session(task)
        agent_start_attempted = True
        session["agent_start_attempted"] = True
        persist_execution_session(task)
        started = _herdr_json(
            [
                "agent", "start", agent_name,
                "--kind", "hermes", "--pane", pane_id, "--timeout", "60000",
                "--", "-p", profile, "chat",
                "--continue", session_name, "--create-if-missing",
                "--in", workspace,
            ],
            timeout_seconds=75.0,
        )
        started_agent = (started.get("result") or {}).get("agent")
        if (
            not isinstance(started_agent, dict)
            or str(started_agent.get("name") or "") != agent_name
        ):
            raise RuntimeError("task_session_agent_start_invalid")
        started_pane = str(started_agent.get("pane_id") or "")
        if started_pane and started_pane != pane_id:
            raise RuntimeError("task_session_agent_wrong_pane")
        session["agent_started"] = True
        persist_execution_session(task)
        return session
    except Exception as exc:
        if pane_id and pane_id != coordinator_pane:
            candidates = (pane_id,)
        elif pane_id == coordinator_pane:
            raise RuntimeError(
                "task_session_split_uncertain:coordinator_pane_reused"
            ) from exc
        else:
            try:
                candidates = tuple(
                    candidate
                    for candidate in _find_marked_task_panes(pane_marker, workspace_id)
                    if candidate != coordinator_pane
                )
            except Exception as reconcile_exc:
                raise RuntimeError(
                    f"task_session_split_uncertain:{reconcile_exc}"
                ) from exc
            if not candidates:
                raise RuntimeError(
                    "task_session_split_uncertain:no_marked_pane_found"
                ) from exc
        cleanup_failed = False
        for candidate in candidates:
            if not _cleanup_setup_pane(candidate, coordinator_pane, pane_marker,
                                       agent_name, agent_start_attempted,
                                       preexisting_panes):
                cleanup_failed = True
        if isinstance(task.get("execution_session"), dict):
            session = task["execution_session"]
            if cleanup_failed:
                session["cleanup_status"] = "close_failed"
                session["cleanup_error"] = str(exc)[-1000:]
            elif candidates:
                session["closed_at"] = utcnow().isoformat()
                session["cleanup_status"] = "closed"
        if cleanup_failed:
            raise RuntimeError("task_session_cleanup_failed") from exc
        if isinstance(task.get("execution_session"), dict):
            if task["execution_session"].get("closed_at"):
                stop_bridge(task["execution_session"])
                if task["execution_session"].get("policy_file"):
                    Path(task["execution_session"]["policy_file"]).unlink(missing_ok=True)
            persist_execution_session(task, startup=False)
        raise


def cleanup_task_session(task: dict) -> bool:
    session = task.get("execution_session")
    if not isinstance(session, dict) or not session.get("owned_pane"):
        return True
    if session.get("closed_at"):
        return True
    pane_id = str(session.get("pane_id") or "")
    if not pane_id:
        session["cleanup_status"] = "close_unproven"
        return False
    coordinator_pane = str(session.get("coordinator_pane_id") or "")
    if coordinator_pane and pane_id == coordinator_pane:
        session["cleanup_status"] = "refused"
        session["cleanup_error"] = "owned pane matches persistent coordinator pane"
        log(str(task.get("id") or "unknown"), "task session cleanup refused coordinator pane")
        return False
    try:
        listed = _herdr_json(["pane", "list"], timeout_seconds=10.0)
    except (OSError, RuntimeError, ValueError):
        session["cleanup_status"] = "close_unproven"
        return False
    panes = (listed or {}).get("result", {}).get("panes")
    if not isinstance(panes, list):
        session["cleanup_status"] = "close_unproven"
        return False
    present = any(isinstance(row, dict) and str(row.get("pane_id") or "") == pane_id
                  for row in panes)
    if present:
        agent_name = str(session.get("agent_name") or "")
        marker = str(session.get("pane_marker") or "")
        try:
            agent_payload = (_herdr_json(["agent", "get", agent_name], timeout_seconds=10.0)
                             if agent_name and marker else None)
        except (OSError, RuntimeError, ValueError):
            agent_payload = None
        live = ((agent_payload or {}).get("result") or {}).get("agent")
        try:
            marker_proven = _pane_has_marker(pane_id, marker)
        except (OSError, RuntimeError, ValueError):
            marker_proven = False
        if (not isinstance(live, dict) or live.get("name") != agent_name
                or str(live.get("pane_id") or "") != pane_id
                or not marker_proven):
            session["cleanup_status"] = "close_unproven"
            return False
    if not present or _close_owned_pane(pane_id):
        session["closed_at"] = utcnow().isoformat()
        session["cleanup_status"] = "closed"
        stop_bridge(session)
        if session.get("policy_file"):
            Path(session["policy_file"]).unlink(missing_ok=True)
        return True
    session["cleanup_status"] = "close_failed"
    session["cleanup_error"] = "pane close failed"
    log(str(task.get("id") or "unknown"), f"task session cleanup failed pane={pane_id}")
    return False


def current_task_path(task: dict) -> Path | None:
    name = f"{task['id']}.json"
    for directory in (RUNNING, PENDING, DONE, BLOCKED, FAILED):
        path = directory / name
        if path.exists():
            return path
    return None


def persist_current_task(task: dict) -> None:
    path = current_task_path(task)
    if path is not None:
        write_json(path, task)


def cleanup_task_session_if_safe(task: dict) -> bool:
    """Keep a task-owned pane alive while prompt delivery is still ambiguous."""
    if task.get("attempt_state") == "delivery_uncertain" or task.get("watchdog_blocker") == "active_durable_children":
        return True
    cleaned = cleanup_task_session(task)
    if not cleaned:
        path = current_task_path(task)
        if path is not None:
            task["watchdog_blocker"] = "task_session_cleanup_failed"
            archive_previous_result(
                str(task["id"]), int(task.get("attempts") or 0)
            )
            block_task(
                path,
                task,
                "task_session_cleanup_failed",
                "Old isolated task pane could not be proven closed; further execution is blocked to prevent duplicate work or resource leakage.",
            )
    return cleaned


def prompt_text(task: dict) -> str:
    task_id = str(task["id"])
    result = result_path(task_id)
    run_token = str(task["run_token"])
    base = str(task["prompt"]).strip()
    profile = str(task.get("safety_profile") or "quantlab")
    routing = task.get("routing") if isinstance(task.get("routing"), dict) else {}
    agent = str(routing.get("selected_agent") or task.get("agent") or "quantlab-hermes")
    session = task.get("execution_session") if isinstance(task.get("execution_session"), dict) else {}
    task_agent = str(session.get("agent_name") or agent)
    executor_agent = str(routing.get("executor_agent") or agent)
    tier = str(routing.get("tier") or "free")
    model = str(routing.get("model") or "nous-adaptive-free")
    repo = str(task.get("repo") or "Bbambaaamm/Autonomous-Quant-Lab")
    workspace = str(task.get("workspace") or "/home/agentops/workspaces/quantlab")

    if profile == "dotacni-majak":
        contract = f"""

TASK COMPLETION CONTRACT:
- You are running in isolated durable-task session {task_agent}, derived from coordinator {agent}, under Herdr for GitHub repository {repo}. The persistent coordinator chat is control-plane only and must not receive this task payload.
- Herdr is the parent authority and backlog/DAG orchestrator. Economic implementation, research, testing, or review by a child requires admitted durable delegation before the child prompt is sent.
- Before delivering any economic child prompt, obtain a durable Herdr TaskGraph child with a parent edge, admission decision, lease, fencing token, and idempotency key. Unmanaged persistent-child coding, research, or review prompts are denied; read-only inspection may remain local.
- Work from {workspace}. Before code changes, fetch current origin/main, read docs/AGENT_HANDOFF.md and relevant ADR/spec files, and inspect current issue/PR/main plus prior durable results.
- For code changes use an isolated clean issue worktree under {workspace}/worktrees/. Never contaminate another issue's checkout.
- Preserve Dotační Maják invariants: official-source truth, provenance, UNKNOWN != FAIL, relevance != eligibility, deterministic eligibility/finance, RAW-first ingestion, immutable versioning, disappearance != cancellation, and fail-closed protection against destructive parser/source failures.
- Do not buy or enable paid services, create or expose production credentials, weaken privacy/security/provenance, alter branch protection, bypass CI/review, or perform production deploys/irreversible external actions without explicit authorization.
- Continue autonomously through ordinary technical decisions inside the issue scope.
- Completion flow for mergeable code: builder evidence -> tests -> PR -> CI green -> independent review PASS on the exact PR head SHA -> verify head SHA did not change and no blocking review remains -> merge only if repository protection permits. Any missing/stale gate is FAIL-CLOSED: leave the PR open and report the blocker instead of merging.
- After a successful merge, verify the issue is actually closed/satisfied. If the issue is broad, complete one bounded high-value slice and leave precise durable next_action so intake can safely schedule the next slice.
- Before finishing, write UTF-8 JSON to {result}.
- The JSON MUST contain exactly this task identity: task_id="{task_id}" and run_token="{run_token}".
- Include keys: task_id, run_token, status, summary, issue, repo, evidence, blocker, next_action, completed_at. repo must be "{repo}".
- status must be one of completed, blocked, failed.
- If GitHub write authorization is required, set status=blocked and blocker=github_write_auth_required. Preserve exact branch/patch/evidence and do not redo implementation.
- If user-only approval, paid-provider activation, new credential, production deploy, or another interactive authorization is required, do not guess or self-approve; report the specific blocker.
"""
    elif profile == "herdr-core":
        contract = f"""

TASK COMPLETION CONTRACT:
- You are running in isolated durable-task session {task_agent}, derived from coordinator {agent}, under Herdr for GitHub repository {repo}. The persistent coordinator chat is control-plane only and must not receive this task payload.
- Work from {workspace}. Fetch current origin/main and inspect live issues, PRs, exact-head CI/reviews and prior durable evidence before changing code.
- Root issue #53 is orchestration authority, not an implementation target. Select only dependency-ready AUTO work and avoid duplicating any running task/branch/PR/economic attempt.
- Use isolated clean worktrees under /home/agentops/worktrees/herdr/ for code changes. Never contaminate the persistent coordinator checkout.
- Preserve durable task identity, run_token/idempotency, leases/fencing, bounded retries/fanout, consumer isolation, admission/resource limits and fail-closed reconciliation.
- Before any economic child prompt, obtain a durable Herdr TaskGraph child under this exact task/run_token through admitted delegation. A direct persistent-child coding, research, or review prompt without that child identity is denied. Record denied attempts in the task audit.
- Use {CHILD_HELPER} --key KEY --role ROLE --objective OBJECTIVE --prompt PROMPT with explicit --tool and --permission flags for economic child work. For code-writing children also pass --cwd with the exact existing issue Git worktree under the configured worktree root; the root itself is never granted writable. Direct herdr mutation/delegation and pane-input commands are blocked in this task pane.
- No child may widen permissions above the parent. Never write directly to main or bypass branch protection, CI, review, credentials, billing, deploy holds, release gates or acceptance gates.
- Exact-head merge flow is tests -> CI green -> independent review with no unresolved applicable finding -> unchanged head verification -> merge only if repository protection permits.
- A gated leaf does not block unrelated dependency-ready AUTO work. Do not fabricate elapsed soak evidence; an elapsed-time acceptance wait should end this cycle as completed with a precise next_action for later re-check.
- Use status=blocked only when the whole safe backlog cannot progress without genuine human/credential/external/privileged action.
- Before finishing, write UTF-8 JSON to {result}.
- The JSON MUST contain exactly this task identity: task_id="{task_id}" and run_token="{run_token}".
- Include keys: task_id, run_token, status, summary, issue, repo, evidence, blocker, next_action, completed_at. repo must be "{repo}".
- status must be one of completed, blocked, failed.
"""
    else:
        route_rule = {
            "free": f"- Keep {agent} as the root coordinator. Eligible child nodes may use the FREE route via {executor_agent}; do not replace the parent identity.",
            "sol": f"- Keep {agent} as the root coordinator. The router recommends {executor_agent}/{model} only for bounded child-node capability work; do not replace the parent identity or self-escalate to Astra.",
            "astra": f"- Keep {agent} as the root coordinator. The router recommends {executor_agent}/{model} only for explicitly budgeted bounded child-node work.",
        }.get(tier, "- Keep the parent coordinator stable and apply routing only to bounded child nodes.")
        contract = f"""

TASK COMPLETION CONTRACT:
- You are running in isolated durable-task session {task_agent}, derived from persistent coordinator {agent}; routed child-node tier={tier} executor={executor_agent} model={model}. The persistent coordinator chat is control-plane only and must not receive this task payload.
- Work from the issue-specific clean worktree when code changes are needed; do not contaminate another issue's dirty checkout.
{route_rule}
- Preserve PAPER-only, PIT/causality, provenance, immutable audit and runtime/resource/safety guardrails.
- Do not bypass protected-branch, CI, deploy-hold, credential, approval, billing, or safety controls.
- Continue autonomously through ordinary technical decisions within this bounded slice.
- Any economic child coding, research, testing, or review requires an admitted durable Herdr TaskGraph child before prompt delivery. Direct unmanaged persistent-child prompts are denied; read-only inspection may remain local.
- Before finishing, write UTF-8 JSON to {result}.
- The JSON MUST contain exactly this task identity: task_id="{task_id}" and run_token="{run_token}".
- Include keys: task_id, run_token, status, summary, issue, evidence, blocker, next_action, completed_at.
- status must be one of completed, blocked, failed.
- If GitHub write authorization is required to complete the slice, set status=blocked and blocker=github_write_auth_required. Preserve exact local branch/patch/evidence and do not redo implementation.
- If an interactive approval/question is required, do not guess or approve it yourself; leave it blocked with evidence.
"""
    if task.get("parent_task_id"):
        contract += (f"\n- This admitted child must include fencing_token={task['fencing_token']} "
                     f"and idempotency_key={task['idempotency_key']} in its result JSON. "
                     "Include a nonempty evidence list and artifact_sha256 equal to the SHA-256 "
                     "of that list encoded as sorted-key UTF-8 JSON.\n")
    contract += (f"\n- For economic child work use {CHILD_HELPER} with --key, --role, "
                 "--objective, --prompt and explicit --tool/--permission flags. "
                 "For any write-capable child, also pass --cwd with the exact existing issue Git worktree. "
                 "The durable sandbox blocks every direct Herdr CLI command, including "
                 "the absolute binary path; use this helper for economic child work.\n")
    return base + contract

def run_prompt(task: dict) -> tuple[int, str]:
    if task.get("parent_task_id") and (
        not task.get("run_token") or not task.get("idempotency_key")
        or not task.get("fencing_token") or not task.get("delegation_key")
    ):
        raise RuntimeError("durable_child_admission_identity_missing")
    session = task.get("execution_session")
    if not isinstance(session, dict) or not session.get("agent_name"):
        raise RuntimeError("task_session_isolation_missing")
    agent = str(session["agent_name"])
    timeout_seconds = int(task.get("timeout_seconds") or 1800)
    prompt = prompt_text(task)
    cmd = [
        str(HERDR), "agent", "prompt", agent, prompt,
        "--wait", "--timeout", str(timeout_seconds * 1000),
    ]
    proc = subprocess.run(
        cmd,
        text=True,
        capture_output=True,
        timeout=timeout_seconds + 30,
        env=ENV,
    )
    output = (proc.stdout or "") + (proc.stderr or "")
    return proc.returncode, output

def wait_for_durable_result(task: dict, timeout_seconds: int) -> bool:
    task_id = str(task["id"])
    run_token = str(task.get("run_token") or "")
    deadline = time.monotonic() + max(1, timeout_seconds)
    rp = result_path(task_id)
    while time.monotonic() < deadline:
        if rp.exists():
            try:
                payload = json.loads(rp.read_text(encoding="utf-8"))
            except Exception:
                time.sleep(2)
                continue
            if (
                str(payload.get("task_id") or "") == task_id
                and str(payload.get("run_token") or "") == run_token
            ):
                return True
        time.sleep(2)
    return False


def _swarm_snapshot_evidence(task: dict, spec: dict) -> list[str] | None:
    path = Path(str(spec.get("path") or ""))
    if not path.is_absolute() or not path.exists():
        return None
    try:
        snapshot = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return None
    if not isinstance(snapshot, dict) or snapshot.get("paper_only") is not True:
        return None
    agents = snapshot.get("agents")
    edges = snapshot.get("edges")
    if not isinstance(agents, list) or not isinstance(edges, list):
        return None

    parent_agent = str(spec.get("parent_agent_id") or "")
    parent_task = str(spec.get("parent_task_id") or "")
    minimum = int(spec.get("min_children") or 1)
    parents = [
        row for row in agents
        if isinstance(row, dict)
        and row.get("agent_id") == parent_agent
        and row.get("task_id") == parent_task
        and row.get("state") == "done"
    ]
    children = [
        row for row in agents
        if isinstance(row, dict)
        and row.get("parent_agent_id") == parent_agent
        and row.get("parent_task_id") == parent_task
        and row.get("state") == "done"
    ]
    if len(parents) != 1 or len(children) < minimum:
        return None
    child_ids = {str(row.get("agent_id") or "") for row in children}
    tokens = {int(row.get("fencing_token") or 0) for row in children}
    if "" in child_ids or len(child_ids) != len(children):
        return None
    if 0 in tokens or len(tokens) != len(children):
        return None
    child_tasks = {str(row.get("task_id") or "") for row in children}
    parent_edges = {
        str(row.get("to") or "")
        for row in edges
        if isinstance(row, dict)
        and row.get("kind") == "parent"
        and row.get("from") == parent_task
    }
    if not child_tasks.issubset(parent_edges):
        return None
    return [
        f"trusted swarm snapshot {path}",
        f"parent={parent_agent}/{parent_task} done",
        f"children_done={len(children)} distinct_fencing={len(tokens)}",
    ]


def reconcile_completion_evidence(task: dict) -> bool:
    spec = task.get("completion_evidence")
    if not isinstance(spec, dict):
        return False
    if spec.get("kind") != "herdr_swarm_snapshot":
        return False
    evidence = _swarm_snapshot_evidence(task, spec)
    if evidence is None:
        return False
    write_json(
        result_path(str(task["id"])),
        {
            "task_id": str(task["id"]),
            "run_token": str(task.get("run_token") or ""),
            "status": "completed",
            "summary": "Completion reconciled from trusted Herdr durable runtime evidence.",
            "issue": task.get("issue"),
            "repo": task.get("repo"),
            "evidence": evidence,
            "blocker": None,
            "next_action": "Continue with the next dependency-safe orchestration slice.",
            "completed_at": utcnow().isoformat(),
        },
    )
    return True


def defer_delivery_reconciliation(task_path: Path, task: dict, reason: str) -> None:
    with parent_transition_guard(task) as all_terminal:
        _defer_delivery_reconciliation_locked(task_path, task, reason, all_terminal)


def _defer_delivery_reconciliation_locked(task_path: Path, task: dict, reason: str,
                                          all_terminal: bool) -> None:
    if defer_for_active_children(task_path, task, reason=reason, all_terminal=all_terminal):
        return
    clear_child_wait(task)
    count = int(task.get("delivery_reconcile_count") or 0) + 1
    task["delivery_reconcile_count"] = count
    task["attempt_state"] = "delivery_uncertain"
    observe_task_execution(task)
    task["last_error"] = reason[-2000:]
    maximum = int(task.get("max_delivery_reconciles") or 12)
    if count >= maximum:
        task["watchdog_blocker"] = "delivery_uncertain_requires_recovery"
        task["recovery_action"] = "await_exact_result_or_inspect_session"
        task["delivery_reconcile_pending"] = True
        task["not_before"] = (utcnow() + timedelta(seconds=300)).isoformat()
        write_json(task_path, task)
        move(task_path, BLOCKED)
        return
    delay = min(300, 15 * (2 ** min(count - 1, 4)))
    task["not_before"] = (utcnow() + timedelta(seconds=delay)).isoformat()
    # Reconciliation is handled by recovery. This attempt must never appear
    # in the ordinary dispatch queue while its semantic execution may live.
    task["delivery_reconcile_pending"] = True
    write_json(task_path, task)
    move(task_path, BLOCKED)


def retry(task_path: Path, task: dict, reason: str) -> None:
    """Start a new semantic execution attempt after the prior one is terminal."""
    with parent_transition_guard(task) as all_terminal:
        _retry_locked(task_path, task, reason, all_terminal)


@contextmanager
def parent_transition_guard(task: dict):
    if task.get("parent_task_id") or not task.get("run_token"):
        yield True
    else:
        with parent_attempt_guard(ROOT, str(task.get("id") or ""),
                                  str(task.get("run_token") or "")) as terminal:
            yield terminal


def clear_child_wait(task: dict) -> None:
    if task.get("watchdog_blocker") == "active_durable_children":
        task.pop("watchdog_blocker", None)
        task.pop("recovery_action", None)
        task.pop("delivery_reconcile_pending", None)


def _retry_locked(task_path: Path, task: dict, reason: str, all_terminal: bool) -> None:
    if defer_for_active_children(task_path, task, reason=reason, all_terminal=all_terminal):
        return
    clear_child_wait(task)
    attempts = int(task.get("attempts") or 0) + 1
    task["attempts"] = attempts
    task["last_error"] = reason[-2000:]
    task["attempt_state"] = "retry_scheduled"
    # Keep the prior attempt identity until cleanup succeeds. prepare_attempt()
    # rotates it only when the next semantic attempt is actually allowed to start.
    max_attempts = int(task.get("max_attempts") or 4)
    if attempts >= max_attempts:
        task["attempt_state"] = "failed"
        task["failed_at"] = utcnow().isoformat()
        write_json(task_path, task)
        move(task_path, FAILED)
        return
    delay = min(900, 60 * (2 ** max(0, attempts - 1)))
    task["not_before"] = (utcnow() + timedelta(seconds=delay)).isoformat()
    write_json(task_path, task)
    move(task_path, PENDING)

def block_task(task_path: Path, task: dict, blocker: str, summary: str) -> None:
    with parent_transition_guard(task) as all_terminal:
        _block_task_locked(task_path, task, blocker, summary, all_terminal)


def _block_task_locked(task_path: Path, task: dict, blocker: str, summary: str,
                       all_terminal: bool) -> None:
    task_id = str(task["id"])
    rp = result_path(task_id)
    try:
        info = rp.lstat()
    except FileNotFoundError:
        info = None
    except OSError as exc:
        _defer_delivery_reconciliation_locked(
            task_path, task, f"result metadata unavailable: {exc}", all_terminal)
        return
    if info is not None and not stat.S_ISREG(info.st_mode):
        _defer_delivery_reconciliation_locked(
            task_path, task, "result path is not a regular file", all_terminal)
        return
    if info is None or info.st_size == 0:
        write_json(
            rp,
            {
                "task_id": task_id,
                "run_token": str(task.get("run_token") or ""),
                "status": "blocked",
                "summary": summary,
                "issue": task.get("issue"),
                "repo": task.get("repo"),
                "evidence": [str(task.get("last_error") or summary)],
                "blocker": blocker,
                "next_action": "Resolve the documented blocker, then requeue the same durable task without duplicating implementation.",
                "completed_at": utcnow().isoformat(),
            },
        )
    if defer_for_active_children(task_path, task, reason=summary, all_terminal=all_terminal):
        return
    clear_child_wait(task)
    task["last_error"] = summary[-2000:]
    if not cleanup_task_session(task):
        # `blocked/` is used here only as a quarantine queue. Do not publish a
        # terminal-looking task state until the exact owned pane is absent/closed.
        task["watchdog_cleanup_blocker"] = "task_session_cleanup_failed"
        task["attempt_state"] = "delivery_uncertain"
        task.pop("result_status", None)
        task.pop("finished_at", None)
        write_json(task_path, task)
        if task_path.parent != BLOCKED:
            move(task_path, BLOCKED)
        return
    task.pop("watchdog_cleanup_blocker", None)
    task["result_status"] = "blocked"
    task["attempt_state"] = "blocked"
    task["finished_at"] = utcnow().isoformat()
    write_json(task_path, task)
    move(task_path, BLOCKED)


def defer_for_active_children(task_path: Path, task: dict, *, reason: str = "",
                              all_terminal: bool) -> bool:
    if task.get("parent_task_id") or all_terminal:
        return False
    task["watchdog_blocker"] = "active_durable_children"
    task["recovery_action"] = "await_terminal_durable_children"
    task["attempt_state"] = ("result_ready" if result_path(str(task["id"])).exists()
                             else "delivery_uncertain")
    task["delivery_reconcile_pending"] = True
    if reason:
        task["last_error"] = reason[-2000:]
    write_json(task_path, task)
    move(task_path, BLOCKED)
    return True

def finish(task_path: Path, task: dict, output: str) -> None:
    with parent_transition_guard(task) as all_terminal:
        _finish_locked(task_path, task, output, all_terminal)


def _finish_locked(task_path: Path, task: dict, output: str, all_terminal: bool) -> None:
    task_id = str(task["id"])
    rp = result_path(task_id)
    task["attempt_state"] = "verifying"
    result_payload_present = False
    if rp.exists():
        try:
            info = rp.lstat()
        except OSError as exc:
            _defer_delivery_reconciliation_locked(
                task_path, task, f"result metadata unavailable: {exc}", all_terminal
            )
            return
        if not stat.S_ISREG(info.st_mode):
            _defer_delivery_reconciliation_locked(
                task_path, task, "result path is not a regular file", all_terminal
            )
            return
        result_payload_present = info.st_size > 0
    if not result_payload_present:
        if reconcile_completion_evidence(task):
            rp = result_path(task_id)
        else:
            _defer_delivery_reconciliation_locked(
                task_path, task, "agent settled without required result JSON", all_terminal
            )
            return
    try:
        result = json.loads(rp.read_text(encoding="utf-8"))
    except Exception as exc:
        _defer_delivery_reconciliation_locked(task_path, task, f"invalid result JSON: {exc}", all_terminal)
        return

    if str(result.get("task_id") or "") != task_id:
        _defer_delivery_reconciliation_locked(
            task_path, task, "result task_id does not match durable task", all_terminal
        )
        return
    if str(result.get("run_token") or "") != str(task.get("run_token") or ""):
        _defer_delivery_reconciliation_locked(
            task_path, task, "result run_token does not match current attempt", all_terminal
        )
        return
    evidence = result.get("evidence")
    try:
        evidence_hash = (hashlib.sha256(json.dumps(evidence, sort_keys=True,
                        ensure_ascii=False, allow_nan=False).encode("utf-8")).hexdigest()
                         if isinstance(evidence, list) and evidence else None)
    except (TypeError, ValueError):
        evidence_hash = None
    if task.get("parent_task_id") and (
        result.get("idempotency_key") != task.get("idempotency_key")
        or result.get("fencing_token") != task.get("fencing_token")
        or not task.get("idempotency_key") or not task.get("fencing_token")
        or result.get("artifact_sha256") != evidence_hash
    ):
        _defer_delivery_reconciliation_locked(task_path, task, "child result missing exact fence/idempotency/artifact evidence", all_terminal)
        return

    status = str(result.get("status") or "")
    blocker = str(result.get("blocker") or "").strip()
    if defer_for_active_children(task_path, task, all_terminal=all_terminal):
        return
    clear_child_wait(task)
    # Terminal/retry transition is allowed only after the exact task-owned pane
    # is proven absent or safely closed. A crash before cleanup must leave the
    # task nonterminal so watchdog recovery can retry cleanup from exact result.
    if not cleanup_task_session(task):
        task["watchdog_cleanup_blocker"] = "task_session_cleanup_failed"
        task["last_error"] = (
            "Exact durable result exists, but task-owned pane cleanup could not "
            "be proven; terminal transition is deferred."
        )
        task["attempt_state"] = "delivery_uncertain"
        task.pop("result_status", None)
        task.pop("finished_at", None)
        write_json(task_path, task)
        return
    task.pop("watchdog_cleanup_blocker", None)
    task["agent_output_tail"] = output[-4000:]
    task["result_status"] = status
    task["finished_at"] = utcnow().isoformat()
    task["attempt_state"] = status if status in {"completed", "blocked", "failed"} else "verifying"
    write_json(task_path, task)

    if blocker and blocker.lower() not in {"none", "null"}:
        move(task_path, BLOCKED)
    elif status == "completed":
        task["attempt_state"] = "done"
        write_json(task_path, task)
        move(task_path, DONE)
    elif status == "blocked":
        move(task_path, BLOCKED)
    else:
        _retry_locked(task_path, task, blocker or "agent reported failed", all_terminal)

def main(task_path: Path) -> int:
    lock_fd = os.open(LOCK, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        import fcntl
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 0

        task = json.loads(task_path.read_text(encoding="utf-8"))
        task_id = str(task["id"])

        if task.get("attempt_state") == "delivery_uncertain" and task.get("run_token"):
            log(
                task_id,
                "reconciling ambiguous delivery without redispatch "
                f"count={task.get('delivery_reconcile_count', 0)} "
                f"run_token={task['run_token']}",
            )
            if wait_for_durable_result(task, 1) or reconcile_completion_evidence(task):
                finish(task_path, task, "reconciled durable result without redispatch")
            else:
                defer_delivery_reconciliation(
                    task_path,
                    task,
                    str(task.get("last_error") or "delivery remains uncertain"),
                )
            cleanup_task_session_if_safe(task)
            persist_current_task(task)
            return 0

        previous_session = task.get("execution_session")
        if (
            isinstance(previous_session, dict)
            and previous_session.get("owned_pane")
            and not previous_session.get("closed_at")
        ):
            if not cleanup_task_session_if_safe(task):
                persist_current_task(task)
                return 1
            persist_current_task(task)

        prepare_attempt(task)
        ensure_parent_scope(task)
        attempt_dir = ROOT / "attempts"
        attempt_dir.mkdir(parents=True, exist_ok=True)
        task["task_file"] = str((attempt_dir / f"{task['id']}-{task['run_token']}.json").resolve())
        attempt = int(task.get("attempts") or 0)
        decision = decide_model_route(task)
        task["routing"] = decision
        try:
            record_model_route(task, decision)
        except Exception as exc:
            log(task_id, f"routing telemetry failed: {exc}")
            if decision.get("tier") in {"sol", "astra"}:
                decision = dict(
                    decision,
                    tier="free",
                    selected_agent="quantlab-hermes",
                    coordinator_agent="quantlab-hermes",
                    executor_agent="quantlab-hermes",
                    model="nous-adaptive-free",
                    routing_scope="child_node",
                    reason="routing_audit_unavailable",
                    astra_escalation=False,
                )
                task["routing"] = decision
        write_json(task_path, task)
        log(
            task_id,
            f"start attempt={attempt} tier={decision.get('tier')} "
            f"model={decision.get('model')} agent={decision.get('selected_agent')} "
            f"reason={decision.get('reason')} codex_used={decision.get('codex_used_percent')} "
            f"run_token={task['run_token']}",
        )

        try:
            try:
                session = create_task_session(task)
                write_json(task_path, task)
                log(
                    task_id,
                    "isolated task session created "
                    f"agent={session['agent_name']} pane={session['pane_id']} "
                    f"session={session['session_name']}",
                )
            except Exception as exc:
                detail = str(exc)
                if detail.startswith(
                    (
                        "task_session_cleanup_failed",
                        "task_session_pane_not_isolated",
                        "task_session_split_uncertain",
                    )
                ):
                    block_task(
                        task_path,
                        task,
                        "task_session_isolation_uncertain",
                        f"Task pane ownership/cleanup could not be proven safe: {detail}",
                    )
                    return 1
                retry(task_path, task, f"task_session_isolation_unavailable: {detail}")
                return 1

            try:
                rc, output = run_prompt(task)
            except subprocess.TimeoutExpired as exc:
                defer_delivery_reconciliation(
                    task_path, task, f"dispatcher timeout with unknown delivery state: {exc}"
                )
                return 1

            log(task_id, f"herdr rc={rc} tail={output[-500:]!r}")
            lowered = output.lower()

            if "agent_blocked" in lowered or "requires interactive input" in lowered:
                task["last_error"] = output[-2000:]
                task_agent = str(
                    (task.get("execution_session") or {}).get("agent_name")
                    or task.get('routing', {}).get('selected_agent', 'quantlab-hermes')
                )
                block_task(
                    task_path,
                    task,
                    "agent_interactive_input_required",
                    f"{task_agent} is waiting at an interactive approval/question UI",
                )
                return 0

            if "agent_prompt_stalled" in lowered:
                grace = int(task.get("stall_grace_seconds") or 600)
                grace = max(30, min(grace, int(task.get("timeout_seconds") or 1800)))
                log(
                    task_id,
                    f"prompt observation stalled; reconciling same attempt for up to {grace}s",
                )
                if reconcile_completion_evidence(task) or wait_for_durable_result(task, grace):
                    finish(task_path, task, output)
                    return 0
                defer_delivery_reconciliation(
                    task_path,
                    task,
                    f"agent_prompt_stalled with ambiguous delivery after {grace}s: {output}",
                )
                return 1

            provider_retry = any(
                marker in lowered
                for marker in (
                    "usage limit",
                    "rate limit",
                    "http 429",
                    "too many requests",
                    "provider unavailable",
                )
            )
            if provider_retry:
                # A provider error observed after `herdr agent prompt` does not prove
                # that prompt delivery failed. Preserve the same semantic attempt and
                # reconcile its exact result instead of rotating run/idempotency.
                defer_delivery_reconciliation(
                    task_path, task,
                    output or f"herdr rc={rc} with provider state after prompt delivery",
                )
                return 1

            if rc != 0:
                defer_delivery_reconciliation(
                    task_path,
                    task,
                    output or f"herdr rc={rc} with unknown delivery state",
                )
                return 1

            task["attempt_state"] = "accepted"
            write_json(task_path, task)
            finish(task_path, task, output)
            return 0
        finally:
            cleanup_task_session_if_safe(task)
            persist_current_task(task)
    finally:
        os.close(lock_fd)

if __name__ == "__main__":
    if len(sys.argv) != 2:
        raise SystemExit("usage: agent-task-worker TASK_JSON")
    raise SystemExit(main(Path(sys.argv[1])))
