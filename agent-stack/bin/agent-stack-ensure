#!/usr/bin/env python3
import json
import os
import shutil
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

HOME = Path("/home/agentops")
HERDR = HOME / ".local/bin/herdr"
DC = HOME / ".local/desktop-commander/node_modules/.bin/desktop-commander"
STATE = HOME / ".local/state/agent-stack"
LOG = STATE / "ensure.log"
HERDR_BOOT_LOG = STATE / "herdr-autostart.log"
DC_BOOT_LOG = STATE / "desktop-commander-autostart.log"
CHECKOUT_CLONE_TIMEOUT_SECONDS = 60
AGENT_START_TIMEOUT_SECONDS = 70

ENV = os.environ.copy()
ENV["HOME"] = str(HOME)
ENV["PATH"] = f"{HOME}/.local/node24/bin:{HOME}/.local/bin:/usr/local/bin:/usr/bin:/bin"
ENV["LD_LIBRARY_PATH"] = f"{HOME}/.local/playwright-libs/root/usr/lib/x86_64-linux-gnu:" + ENV.get("LD_LIBRARY_PATH", "")
ENV["AGENT_BROWSER_ARGS"] = "--no-sandbox,--disable-dev-shm-usage"

DESIRED = [
    {
        "label": "Majak",
        "cwd": str(HOME / "workspaces/majak"),
        "agents": [
            {"tab": "Codex", "name": "majak-codex", "kind": "codex", "args": []},
            {"tab": "Hermes", "name": "majak-hermes", "kind": "hermes", "args": ["-p", "majak", "chat"]},
        ],
    },
    {
        "label": "QuantLab",
        "cwd": str(HOME / "workspaces/quantlab"),
        "agents": [
            {"tab": "Codex", "name": "quantlab-codex", "kind": "codex", "args": []},
            {"tab": "Hermes", "name": "quantlab-hermes", "kind": "hermes", "args": ["-p", "quantlab", "chat"]},
            {"tab": "Sol", "name": "quantlab-sol", "kind": "codex", "args": ["-m", "gpt-6-sol"]},
            {"tab": "Astra", "name": "quantlab-astra", "kind": "codex", "args": ["-m", "gpt-6-astra"]},
        ],
    },
    {
        "label": "DotacniMajak",
        "cwd": str(HOME / "workspaces/dotacni-majak"),
        "agents": [
            {"tab": "Codex", "name": "dotacni-majak-codex", "kind": "codex", "args": []},
            {"tab": "Hermes", "name": "dotacni-majak-hermes", "kind": "hermes", "args": ["-p", "majak", "chat"]},
        ],
    },
    {
        "label": "Herdr",
        "cwd": str(HOME / "workspaces/herdr"),
        "repository": "Bbambaaamm/herdr",
        "repo_url": "https://github.com/Bbambaaamm/herdr.git",
        "agents": [
            {"tab": "Codex", "name": "herdr-codex", "kind": "codex", "args": []},
            # Runtime-compatible Hermes model/tool wiring; repository authority
            # is supplied independently by the herdr-core task policy.
            {"tab": "Hermes", "name": "herdr-hermes", "kind": "hermes", "args": ["-p", "quantlab", "chat"]},
        ],
    },
]

STATE.mkdir(parents=True, exist_ok=True)

def log(message):
    line = f"{datetime.now().isoformat(timespec='seconds')} {message}"
    with LOG.open("a", encoding="utf-8") as fh:
        fh.write(line + "\n")
    print(line, flush=True)

def run(args, timeout=30):
    return subprocess.run(
        [str(x) for x in args],
        text=True,
        capture_output=True,
        timeout=timeout,
        env=ENV,
    )

def _normalized_origin(value):
    value = str(value or "").strip().rstrip("/")
    return value[:-4] if value.endswith(".git") else value


def _origin_allowed(origin, repository, repo_url):
    expected = {
        _normalized_origin(repo_url),
        _normalized_origin(f"https://github.com/{repository}"),
        _normalized_origin(f"git@github.com:{repository}"),
        _normalized_origin(f"ssh://git@github.com/{repository}"),
    }
    return _normalized_origin(origin) in expected


def _verify_repo_checkout(path, repository, repo_url):
    inside = run(
        ["/usr/bin/git", "-C", path, "rev-parse", "--is-inside-work-tree"],
        timeout=10,
    )
    fetch_proc = run(
        ["/usr/bin/git", "-C", path, "remote", "get-url", "--all", "origin"],
        timeout=10,
    )
    push_proc = run(
        ["/usr/bin/git", "-C", path, "remote", "get-url", "--push", "--all", "origin"],
        timeout=10,
    )
    head = run(
        ["/usr/bin/git", "-C", path, "rev-parse", "--verify", "HEAD"],
        timeout=10,
    )
    fetch_urls = [line.strip() for line in (fetch_proc.stdout or "").splitlines() if line.strip()]
    push_urls = [line.strip() for line in (push_proc.stdout or "").splitlines() if line.strip()]
    urls_ok = (
        bool(fetch_urls)
        and bool(push_urls)
        and all(_origin_allowed(url, repository, repo_url) for url in fetch_urls)
        and all(_origin_allowed(url, repository, repo_url) for url in push_urls)
    )
    if (
        inside.returncode != 0
        or (inside.stdout or "").strip() != "true"
        or fetch_proc.returncode != 0
        or push_proc.returncode != 0
        or not urls_ok
        or head.returncode != 0
    ):
        reported = ",".join(fetch_urls + push_urls) or "unavailable"
        raise RuntimeError(
            f"Workspace {path} checkout invalid or origin mismatch: {reported}"
        )


def ensure_repo_checkout(cwd, repository, repo_url):
    path = Path(cwd)
    git_dir = path / ".git"
    if git_dir.exists():
        _verify_repo_checkout(path, repository, repo_url)
        log(f"Workspace checkout {repository}: present")
        return

    if path.exists() and any(path.iterdir()):
        raise RuntimeError(f"Workspace {path} is non-empty but is not a git checkout")

    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.parent / f".{path.name}.clone-{os.getpid()}"
    shutil.rmtree(temporary, ignore_errors=True)
    try:
        proc = run(
            [
                "/usr/bin/git", "clone", "--depth", "1", "--no-tags",
                "--origin", "origin", "--", repo_url, temporary,
            ],
            timeout=CHECKOUT_CLONE_TIMEOUT_SECONDS,
        )
        if proc.returncode != 0:
            raise RuntimeError((proc.stderr or proc.stdout or "git clone failed").strip())
        _verify_repo_checkout(temporary, repository, repo_url)
        if path.exists():
            path.rmdir()
        os.replace(temporary, path)
    finally:
        shutil.rmtree(temporary, ignore_errors=True)
    log(f"Workspace checkout {repository}: cloned")


def parse_json_output(proc):
    if proc.returncode != 0:
        raise RuntimeError((proc.stderr or proc.stdout or "command failed").strip())
    text = proc.stdout.strip()
    for line in reversed(text.splitlines()):
        line = line.strip()
        if line.startswith("{"):
            return json.loads(line)
    if text.startswith("{"):
        return json.loads(text)
    raise RuntimeError(f"no JSON output: {text[-500:]}")

def herdr_json(*args, timeout=30):
    return parse_json_output(run([HERDR, *args], timeout=timeout))

def process_lines():
    proc = run(["ps", "-u", str(os.getuid()), "-o", "args="], timeout=10)
    return proc.stdout.splitlines() if proc.returncode == 0 else []

def ensure_desktop_commander():
    if any("desktop-commander" in line and " remote" in line for line in process_lines()):
        log("Desktop Commander: healthy")
        return
    if not DC.exists():
        log(f"Desktop Commander: executable missing at {DC}")
        return
    with DC_BOOT_LOG.open("ab") as fh:
        subprocess.Popen(
            [str(DC), "remote"],
            stdout=fh,
            stderr=subprocess.STDOUT,
            env=ENV,
            start_new_session=True,
        )
    log("Desktop Commander: start requested")

def herdr_ready():
    try:
        herdr_json("workspace", "list", timeout=8)
        return True
    except Exception:
        return False

def ensure_herdr_server():
    if herdr_ready():
        log("Herdr server: healthy")
        return
    with HERDR_BOOT_LOG.open("ab") as fh:
        subprocess.Popen(
            [str(HERDR), "server"],
            stdout=fh,
            stderr=subprocess.STDOUT,
            env=ENV,
            start_new_session=True,
        )
    for _ in range(30):
        time.sleep(1)
        if herdr_ready():
            log("Herdr server: restored")
            return
    raise RuntimeError("Herdr server did not become ready")

def list_workspaces():
    data = herdr_json("workspace", "list")
    return data["result"]["workspaces"]

def list_tabs():
    data = herdr_json("tab", "list")
    return data["result"]["tabs"]

def list_panes(workspace_id):
    data = herdr_json("pane", "list", "--workspace", workspace_id)
    return data["result"]["panes"]

def list_agents():
    data = herdr_json("agent", "list")
    return data["result"]["agents"]

def ensure_workspace(label, cwd):
    workspaces = list_workspaces()
    match = next((w for w in workspaces if w.get("label") == label), None)
    if match:
        return match["workspace_id"]
    proc = run([HERDR, "workspace", "create", "--cwd", cwd, "--label", label, "--no-focus"])
    data = parse_json_output(proc)
    wid = data["result"]["workspace"]["workspace_id"]
    log(f"Workspace {label}: created as {wid}")
    return wid

def ensure_tabs(workspace_id, cwd, desired_labels):
    tabs = [t for t in list_tabs() if t.get("workspace_id") == workspace_id]
    by_label = {t.get("label"): t for t in tabs}
    if "Codex" in desired_labels and "Codex" not in by_label:
        if len(tabs) == 1:
            tid = tabs[0]["tab_id"]
            proc = run([HERDR, "tab", "rename", tid, "Codex"])
            if proc.returncode != 0:
                raise RuntimeError(proc.stderr or proc.stdout)
            log(f"{workspace_id}: renamed initial tab to Codex")
        else:
            proc = run([HERDR, "tab", "create", "--workspace", workspace_id, "--cwd", cwd, "--label", "Codex", "--no-focus"])
            if proc.returncode != 0:
                raise RuntimeError(proc.stderr or proc.stdout)
            log(f"{workspace_id}: created Codex tab")
    for label in desired_labels:
        if label == "Codex":
            continue
        tabs = [t for t in list_tabs() if t.get("workspace_id") == workspace_id]
        by_label = {t.get("label"): t for t in tabs}
        if label in by_label:
            continue
        proc = run([HERDR, "tab", "create", "--workspace", workspace_id, "--cwd", cwd, "--label", label, "--no-focus"])
        if proc.returncode != 0:
            raise RuntimeError(proc.stderr or proc.stdout)
        log(f"{workspace_id}: created {label} tab")

def healthy_agent_names():
    healthy_states = {"idle", "done", "working", "blocked"}
    names = set()
    for agent in list_agents():
        if agent.get("name") and agent.get("interactive_ready") and agent.get("agent_status") in healthy_states:
            names.add(agent["name"])
    return names

def pane_for_tab(workspace_id, tab_id):
    panes = [p for p in list_panes(workspace_id) if p.get("tab_id") == tab_id]
    if not panes:
        raise RuntimeError(f"No pane found for {tab_id}")
    return panes[0]["pane_id"]

def ensure_agent(workspace_id, spec):
    if spec["name"] in healthy_agent_names():
        log(f"{spec['name']}: healthy")
        return
    tabs = [t for t in list_tabs() if t.get("workspace_id") == workspace_id]
    tab = next((t for t in tabs if t.get("label") == spec["tab"]), None)
    if not tab:
        raise RuntimeError(f"Missing tab {spec['tab']} in {workspace_id}")
    pane = pane_for_tab(workspace_id, tab["tab_id"])
    cmd = [
        HERDR, "agent", "start", spec["name"],
        "--kind", spec["kind"], "--pane", pane, "--timeout", "60000",
    ]
    if spec["args"]:
        cmd += ["--", *spec["args"]]
    proc = run(cmd, timeout=AGENT_START_TIMEOUT_SECONDS)
    if proc.returncode != 0:
        raise RuntimeError((proc.stderr or proc.stdout).strip())
    log(f"{spec['name']}: restored in {pane}")

def main():
    log("=== ensure start ===")
    ensure_desktop_commander()
    ensure_herdr_server()
    for group in DESIRED:
        if group.get("repository"):
            ensure_repo_checkout(group["cwd"], group["repository"], group["repo_url"])
        wid = ensure_workspace(group["label"], group["cwd"])
        ensure_tabs(wid, group["cwd"], [spec["tab"] for spec in group["agents"]])
        for spec in group["agents"]:
            ensure_agent(wid, spec)
    names = sorted(a.get("name", "") for a in list_agents())
    missing = [s["name"] for g in DESIRED for s in g["agents"] if s["name"] not in names]
    if missing:
        raise RuntimeError("Missing after ensure: " + ", ".join(missing))
    log("Stack ready: " + ", ".join(n for n in names if n))
    log("=== ensure complete ===")

if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        log(f"ERROR: {exc}")
        sys.exit(1)
