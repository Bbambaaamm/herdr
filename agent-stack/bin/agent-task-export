#!/usr/bin/env python3
import json
import os
import re
from collections import defaultdict
from datetime import datetime, timezone
from pathlib import Path

HOME = Path("/home/agentops")
ROOT = HOME / ".local/state/agent-stack/tasks"
OUTPUT = Path("/var/lib/agent-platform-herdr/queue.json")
INTAKE = ROOT / "github-intake-state.json"
STATES = ("running", "blocked", "failed", "pending", "done")
SAFE = re.compile(r"^[A-Za-z0-9._:/-]{1,160}$")
PR_RE = re.compile(r"(?:/pull/|PR\s*#)(\d{1,9})", re.IGNORECASE)
LEGACY_REPO = "Bbambaaamm/Autonomous-Quant-Lab"
REPO_PROFILES = {
    LEGACY_REPO: "quantlab",
    "Bbambaaamm/dotacni-majak": "majak",
}
PROFILE_AGENTS = {
    "quantlab": "quantlab-hermes",
    "majak": "dotacni-majak-hermes",
}
PROFILE_LIMIT = 50


def epoch(value):
    if value in (None, ""):
        return None
    try:
        parsed = datetime.fromisoformat(str(value).replace("Z", "+00:00"))
        if parsed.tzinfo is None:
            return None
        stamp = int(parsed.astimezone(timezone.utc).timestamp())
        return stamp if 0 <= stamp < 2**53 else None
    except (ValueError, TypeError, OverflowError):
        return None


def safe_text(value, default=None, limit=128):
    if (
        isinstance(value, str)
        and 0 < len(value) <= limit
        and SAFE.fullmatch(value)
    ):
        return value
    return default


def clean_title(value):
    if not isinstance(value, str):
        return None
    value = " ".join(value.split())
    if not value or len(value) > 160 or any(ord(ch) < 32 for ch in value):
        return None
    return value


def intake_identity(key, value):
    if not isinstance(value, dict):
        return None
    text = str(key)
    if text.isdigit():
        repo, issue_text = LEGACY_REPO, text
    else:
        repo, separator, issue_text = text.rpartition("#")
        if not separator or repo not in REPO_PROFILES or not issue_text.isdigit():
            return None
    number = int(issue_text)
    if not 0 < number < 10**9:
        return None
    declared_repo = value.get("repo")
    declared_issue = value.get("issue")
    if declared_repo is not None and declared_repo != repo:
        return None
    if declared_issue is not None and declared_issue != number:
        return None
    return repo, number


def intake_state():
    if not INTAKE.is_file():
        return {}
    try:
        raw = json.loads(INTAKE.read_text(encoding="utf-8"))
    except Exception:
        return {}
    if not isinstance(raw, dict):
        return {}
    out = {}
    for key, value in raw.items():
        identity = intake_identity(key, value)
        if identity is None:
            continue
        out[identity] = {
            "open": value.get("open") is True,
            "title": clean_title(value.get("title")),
            "scheduler_state": safe_text(value.get("scheduler_state")),
            "seen_at": epoch(value.get("seen_at")),
        }
    return out


def result_info(task_id, run_token=None):
    path = ROOT / "results" / f"{task_id}.json"
    if not path.is_file():
        return None, None
    try:
        raw = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return "details_available", None
    if str(raw.get("task_id") or "") != task_id:
        return None, None
    if run_token not in (None, "") and str(raw.get("run_token") or "") != str(run_token):
        return None, None
    value = raw.get("blocker")
    blocker = None if value in (None, "") else safe_text(value, "details_available")
    chunks = []
    for key in ("summary", "next_action"):
        if isinstance(raw.get(key), str):
            chunks.append(raw[key])
    evidence = raw.get("evidence")
    if isinstance(evidence, list):
        chunks.extend(item for item in evidence if isinstance(item, str))
    match = PR_RE.search("\n".join(chunks))
    pr_number = int(match.group(1)) if match else None
    return blocker, pr_number


def rows():
    items = []
    counts = defaultdict(int)
    seen = set()
    issues = intake_state()
    for state in STATES:
        folder = ROOT / state
        for path in sorted(
            folder.glob("*.json"), key=lambda p: p.stat().st_mtime, reverse=True
        ):
            try:
                raw = json.loads(path.read_text(encoding="utf-8"))
            except Exception:
                continue
            task_id = safe_text(raw.get("id"), limit=128)
            if not task_id or task_id in seen:
                continue
            raw_repo = raw.get("repo", LEGACY_REPO)
            repo = safe_text(raw_repo, limit=160)
            profile = REPO_PROFILES.get(repo)
            if profile is None or counts[profile] >= PROFILE_LIMIT:
                continue
            expected_agent = PROFILE_AGENTS[profile]
            raw_agent = raw.get("agent")
            if profile == "quantlab" and raw_agent is None:
                agent = expected_agent  # legacy QuantLab task compatibility
            else:
                agent = safe_text(raw_agent, limit=128)
            if agent != expected_agent:
                continue
            issue = raw.get("issue")
            if issue is not None and (
                type(issue) is not int or not 0 < issue < 10**9
            ):
                issue = None
            attempts = raw.get("attempts", 0)
            if type(attempts) is not int or not 0 <= attempts <= 1000:
                attempts = 0
            max_attempts = raw.get("max_attempts", 0)
            if type(max_attempts) is not int or not 0 <= max_attempts <= 1000:
                max_attempts = 0
            kind = safe_text(raw.get("kind"), "unknown", limit=64)
            blocker, pr_number = result_info(task_id, raw.get("run_token"))
            meta = issues.get((repo, issue), {}) if issue is not None else {}
            items.append(
                {
                    "task_id": task_id,
                    "repo": repo,
                    "issue": issue,
                    "issue_title": meta.get("title"),
                    "issue_open": meta.get("open") is True,
                    "scheduler_state": meta.get("scheduler_state"),
                    "status": state,
                    "attempts": attempts,
                    "max_attempts": max_attempts,
                    "not_before": epoch(raw.get("not_before")),
                    "updated_at": int(path.stat().st_mtime),
                    "agent": agent,
                    "kind": kind,
                    "blocker": blocker if state in ("blocked", "failed") else None,
                    "pr_number": pr_number,
                }
            )
            counts[profile] += 1
            seen.add(task_id)
    return items


def main():
    observed_at = int(datetime.now(timezone.utc).timestamp())
    payload = {
        "version": 3,
        "observed_at": observed_at,
        "tasks": rows(),
    }
    OUTPUT.parent.mkdir(parents=True, exist_ok=True)
    temporary = OUTPUT.with_name(f".{OUTPUT.name}.{os.getpid()}.tmp")
    temporary.write_text(
        json.dumps(payload, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
        + "\n",
        encoding="utf-8",
    )
    os.chmod(temporary, 0o640)
    os.replace(temporary, OUTPUT)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
