#!/usr/bin/env python3
import json
import hashlib
import importlib.util
import os
import subprocess
import sys
import time
from datetime import datetime, timedelta, timezone
from pathlib import Path
from contextlib import contextmanager
from importlib.machinery import SourceFileLoader
from agent_durable_children import parent_attempt_guard

from agent_completion_evidence import EvidenceError, record_verification_failure, verification_applies, verify_completion

HOME = Path("/home/agentops")
HERDR = HOME / ".local/bin/herdr"
ROOT = HOME / ".local/state/agent-stack/tasks"
RUNNING = ROOT / "running"
DONE = ROOT / "done"
BLOCKED = ROOT / "blocked"
FAILED = ROOT / "failed"
RESULTS = ROOT / "results"
ORPHAN_GRACE_SECONDS = 300
PANE_SUPERSESSION_GRACE_SECONDS = 3600
TASK_PANE_ENV = "HERDR_DURABLE_TASK_PANE"

ENV = os.environ.copy()
ENV["HOME"] = str(HOME)
ENV["PATH"] = f"{HOME}/.local/node24/bin:{HOME}/.local/bin:/usr/local/bin:/usr/bin:/bin"


def utcnow() -> datetime:
    return datetime.now(timezone.utc)


def write_json(path: Path, payload: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(payload, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)


def parse_started(task: dict, path: Path) -> datetime:
    candidates = [datetime.fromtimestamp(path.stat().st_mtime, timezone.utc)]
    for key in ("dispatch_claimed_at", "attempt_started_at"):
        raw = str(task.get(key) or "").strip()
        if not raw:
            continue
        try:
            candidates.append(
                datetime.fromisoformat(raw.replace("Z", "+00:00")).astimezone(timezone.utc)
            )
        except ValueError:
            continue
    return max(candidates)


def active_worker_tasks() -> set[Path]:
    active: set[Path] = set()
    proc_root = Path("/proc")
    for entry in proc_root.iterdir():
        if not entry.name.isdigit():
            continue
        try:
            args = [
                item.decode("utf-8", errors="replace")
                for item in (entry / "cmdline").read_bytes().split(b"\0")
                if item
            ]
        except (FileNotFoundError, PermissionError, ProcessLookupError):
            continue
        for idx, arg in enumerate(args[:-1]):
            if arg.endswith("/agent-task-worker") or arg == "agent-task-worker":
                try:
                    active.add(Path(args[idx + 1]).resolve())
                except OSError:
                    active.add(Path(args[idx + 1]))
                break
    return active


def matching_result(task: dict) -> tuple[dict | None, str]:
    task_id = str(task.get("id") or "")
    run_token = str(task.get("run_token") or "")
    path = RESULTS / f"{task_id}.json"
    if not path.exists():
        return None, "missing"
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return None, "invalid_json"
    if not isinstance(payload, dict):
        return None, "invalid_shape"
    if str(payload.get("task_id") or "") != task_id:
        return None, "task_id_mismatch"
    if str(payload.get("run_token") or "") != run_token:
        return None, "run_token_mismatch"
    if task.get("parent_task_id"):
        evidence = payload.get("evidence")
        try:
            evidence_hash = (hashlib.sha256(json.dumps(evidence, sort_keys=True,
                                ensure_ascii=False, allow_nan=False).encode("utf-8")).hexdigest()
                             if isinstance(evidence, list) and evidence else None)
        except (TypeError, ValueError):
            evidence_hash = None
        if (payload.get("idempotency_key") != task.get("idempotency_key")
                or payload.get("fencing_token") != task.get("fencing_token")
                or not task.get("idempotency_key") or not task.get("fencing_token")
                or payload.get("artifact_sha256") != evidence_hash):
            return None, "child_evidence_mismatch"
    return payload, "matched"


def observe_task_execution(task: dict) -> str:
    session = task.get("execution_session")
    state = "unavailable"
    if isinstance(session, dict) and not session.get("closed_at"):
        pane_id = str(session.get("pane_id") or "")
        marker = str(session.get("pane_marker") or "")
        agent_name = str(session.get("agent_name") or "")
        routing = task.get("routing") if isinstance(task.get("routing"), dict) else {}
        coordinator = str(routing.get("selected_agent") or task.get("agent") or "quantlab-hermes")
        token = str(task.get("run_token") or "")
        digest = hashlib.sha256(f"{coordinator}:{task.get('id')}:{token}".encode()).hexdigest()
        expected_agent = f"{coordinator[:13].rstrip('-_') or 'task'}-t-{digest[:16]}"
        expected_marker = f"durable-{digest[:20]}"
        if (pane_id and token and agent_name == expected_agent and marker == expected_marker
                and session.get("session_name") == expected_marker
                and _pane_has_marker(pane_id, marker)):
            payload = _herdr_json(["agent", "get", agent_name], timeout=10.0)
            agent = ((payload or {}).get("result") or {}).get("agent")
            if isinstance(agent, dict) and str(agent.get("pane_id") or "") == pane_id:
                status = str(agent.get("agent_status") or agent.get("status") or "").lower()
                state = {"working": "working", "busy": "working",
                         "blocked": "blocked", "done": "settled",
                         "idle": "settled"}.get(status, "unavailable")
    task["observed_execution"] = {
        "state": state, "source": "herdr_agent_get+task_pane_marker",
        "observed_at": utcnow().isoformat(),
        "task_id": str(task.get("id") or ""),
        "run_token": str(task.get("run_token") or ""),
    }
    return state


def move_task(path: Path, target_dir: Path, task: dict) -> None:
    target_dir.mkdir(parents=True, exist_ok=True)
    write_json(path, task)
    os.replace(path, target_dir / path.name)


def watchdog_result_path(task_id: str) -> Path:
    # Recovery evidence is always sidecar-only. The canonical result path is
    # owned by the task executor/runtime and must never be overwritten.
    stamp = utcnow().strftime("%Y%m%dT%H%M%S.%fZ")
    return RESULTS / f"{task_id}.watchdog-recovery-{stamp}-{os.getpid()}.json"


def _herdr_json(args: list[str], timeout: float = 15.0) -> dict | None:
    try:
        proc = subprocess.run(
            [str(HERDR), *args],
            text=True,
            capture_output=True,
            timeout=timeout,
            env=ENV,
        )
    except (OSError, subprocess.SubprocessError):
        return None

    if proc.returncode != 0:
        return None

    for raw in reversed((proc.stdout or "").splitlines()):
        candidate = raw.strip()
        if not candidate.startswith("{"):
            continue
        try:
            payload = json.loads(candidate)
        except json.JSONDecodeError:
            continue
        if isinstance(payload, dict):
            return payload

    return None


def _pane_presence(pane_id: str) -> bool | None:
    payload = _herdr_json(["pane", "list"], timeout=10.0)
    if payload is None:
        return None

    panes = (payload.get("result") or {}).get("panes")
    if not isinstance(panes, list):
        return None

    return any(
        isinstance(row, dict)
        and str(row.get("pane_id") or "") == pane_id
        for row in panes
    )


def _pane_has_marker(pane_id: str, marker: str) -> bool:
    if not marker:
        return False

    payload = _herdr_json(
        ["pane", "process-info", "--pane", pane_id],
        timeout=10.0,
    )
    if payload is None:
        return False

    process_info = (payload.get("result") or {}).get("process_info")
    if not isinstance(process_info, dict):
        return False

    try:
        shell_pid = int(process_info.get("shell_pid") or 0)
    except (TypeError, ValueError):
        return False

    if shell_pid <= 0:
        return False

    try:
        environ = Path(
            f"/proc/{shell_pid}/environ"
        ).read_bytes().split(b"\0")
    except OSError:
        return False

    expected = f"{TASK_PANE_ENV}={marker}".encode("utf-8")
    return expected in environ


def _pane_shell_started_at(pane_id: str) -> float | None:
    process_payload = _herdr_json(
        ["pane", "process-info", "--pane", pane_id],
        timeout=10.0,
    )
    process_info = (
        ((process_payload or {}).get("result") or {}).get("process_info")
    )
    if not isinstance(process_info, dict):
        return False, None

    try:
        shell_pid = int(process_info.get("shell_pid") or 0)
        raw_stat = Path(f"/proc/{shell_pid}/stat").read_text(encoding="utf-8")
        fields = raw_stat[raw_stat.rfind(")") + 2 :].split()
        start_ticks = int(fields[19])
        ticks_per_second = os.sysconf(os.sysconf_names["SC_CLK_TCK"])
        boot_epoch = next(
            int(line.split()[1])
            for line in Path("/proc/stat").read_text(encoding="utf-8").splitlines()
            if line.startswith("btime ")
        )
    except (OSError, StopIteration, TypeError, ValueError):
        return None

    return boot_epoch + start_ticks / ticks_per_second


def _pane_identity_superseded(session: dict) -> tuple[bool, int | None]:
    """Prove that a reused pane id no longer names the task-owned shell."""
    pane_id = str(session.get("pane_id") or "")
    expected_agent = str(session.get("agent_name") or "")
    created_raw = str(session.get("created_at") or "")
    if not pane_id or not expected_agent or not created_raw:
        return False, None

    agents_payload = _herdr_json(["agent", "list"], timeout=10.0)
    if agents_payload is None:
        return False, None
    agents = (agents_payload.get("result") or {}).get("agents")
    if not isinstance(agents, list):
        return False, None
    rows = [row for row in agents if isinstance(row, dict)]
    if any(str(row.get("name") or "") == expected_agent for row in rows):
        return False, None
    if any(str(row.get("pane_id") or "") == pane_id for row in rows):
        return False, None

    shell_epoch = _pane_shell_started_at(pane_id)
    if shell_epoch is None:
        return False, None

    try:
        created = datetime.fromisoformat(
            created_raw.replace("Z", "+00:00")
        ).astimezone(timezone.utc)
    except ValueError:
        return False, None

    delta = int(shell_epoch - created.timestamp())
    return delta > PANE_SUPERSESSION_GRACE_SECONDS, delta


def cleanup_task_owned_pane(task: dict) -> bool:
    session = task.get("execution_session")

    if not isinstance(session, dict) or not session.get("owned_pane"):
        return True

    if session.get("closed_at"):
        return True

    pane_id = str(session.get("pane_id") or "")
    marker = str(session.get("pane_marker") or "")
    coordinator_pane = str(
        session.get("coordinator_pane_id") or ""
    )

    if (
        not pane_id
        or not marker
        or (coordinator_pane and pane_id == coordinator_pane)
    ):
        session["cleanup_status"] = "close_unproven"
        session["cleanup_error"] = (
            "task pane identity is incomplete or unsafe"
        )
        return False

    present = _pane_presence(pane_id)

    # Pane is already gone: cleanup objective is satisfied.
    if present is False:
        session["closed_at"] = utcnow().isoformat()
        session["cleanup_status"] = "already_absent"
        session.pop("cleanup_error", None)
        stop_task_bridge(session)
        return True

    if present is None:
        session["cleanup_status"] = "close_unproven"
        session["cleanup_error"] = (
            "pane presence could not be verified"
        )
        return False

    # Never close a currently existing pane only because an old pane_id
    # happens to match. Durable task marker must prove ownership.
    if not _pane_has_marker(pane_id, marker):
        superseded, delta = _pane_identity_superseded(session)
        if superseded:
            resolved_at = utcnow().isoformat()
            session["superseded_at"] = resolved_at
            session["closed_at"] = resolved_at
            session["cleanup_status"] = "superseded_identity_proven"
            session["cleanup_evidence"] = {
                "version": 1,
                "expected_agent_absent": True,
                "current_pane_unbound": True,
                "ownership_marker_absent": True,
                "shell_started_after_session_seconds": delta,
                "current_pane_close_performed": False,
            }
            session.pop("cleanup_error", None)
            stop_task_bridge(session)
            return True
        session["cleanup_status"] = "close_unproven"
        session["cleanup_error"] = "pane ownership marker mismatch"
        return False

    try:
        proc = subprocess.run(
            [str(HERDR), "pane", "close", pane_id],
            text=True,
            capture_output=True,
            timeout=15,
            env=ENV,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        session["cleanup_status"] = "close_failed"
        session["cleanup_error"] = str(exc)[-1000:]
        return False

    if proc.returncode != 0:
        session["cleanup_status"] = "close_failed"
        session["cleanup_error"] = (
            proc.stderr
            or proc.stdout
            or "pane close failed"
        )[-1000:]
        return False

    session["closed_at"] = utcnow().isoformat()
    session["cleanup_status"] = "closed"
    session.pop("cleanup_error", None)
    stop_task_bridge(session)
    return True


def _worker_bridge():
    bin_dir = Path(__file__).resolve().parent
    if str(bin_dir) not in sys.path:
        sys.path.insert(0, str(bin_dir))
    loader = SourceFileLoader("agent_task_worker_bridge_recovery", str(bin_dir / "agent-task-worker"))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def stop_task_bridge(session: dict) -> None:
    if session.get("bridge_pid"):
        _worker_bridge().stop_bridge(session)
    if session.get("policy_file"):
        Path(session["policy_file"]).unlink(missing_ok=True)


def ensure_live_task_bridge(path: Path, task: dict) -> bool:
    session = task.get("execution_session")
    if (not isinstance(session, dict) or not session.get("sandbox_verified")
            or session.get("closed_at") or task.get("attempt_state") not in
            {"accepted", "delivery_uncertain", "result_ready", "verifying"}):
        return False
    worker = _worker_bridge()
    observed = observe_task_execution(task)
    if observed == "unavailable":
        if task.get("watchdog_blocker") == "active_durable_children" and worker.bridge_alive(session):
            return True
        if worker.bridge_alive(session):
            worker.stop_bridge(session)
        return False
    if worker.bridge_alive(session):
        return True
    worker.LOGS = ROOT / "logs"
    # Queue transitions move the canonical task file (running -> blocked).
    # The sandbox client does not trust a path; the outer bridge resolves the
    # current queue location, and recovery seeds restart with that location.
    task["task_file"] = str(path.resolve())
    try:
        worker.start_bridge(task, session)
    except (OSError, RuntimeError, ValueError):
        return False
    write_json(path, task)
    return True
@contextmanager
def parent_transition_guard(task: dict):
    if task.get("parent_task_id") or not task.get("run_token"):
        yield True
    else:
        with parent_attempt_guard(ROOT, str(task.get("id") or ""),
                                  str(task["run_token"]),
                                  reconcile_results=(
                                      task.get("watchdog_blocker") == "active_durable_children"
                                      or task.get("attempt_state") in {
                                          "result_ready", "delivery_uncertain"
                                      })) as terminal:
            yield terminal


def block_orphan(path: Path, task: dict, *, reason: str, age_seconds: int) -> None:
    with parent_transition_guard(task):
        _block_orphan_locked(path, task, reason=reason, age_seconds=age_seconds)


def _block_orphan_locked(path: Path, task: dict, *, reason: str, age_seconds: int) -> None:
    """Quarantine unknown delivery by atomically retiring it from running."""
    task_id = str(task.get("id") or path.stem)
    blocker = "orphaned_running_unknown_delivery"
    if task.get("watchdog_blocker") != blocker:
        summary = (
            f"Watchdog found orphaned running task with no matching worker after "
            f"{age_seconds}s; delivery state is unknown, so no blind redispatch was performed."
        )
        result = {
            "task_id": task_id,
            "run_token": str(task.get("run_token") or ""),
            "status": "blocked",
            "summary": summary,
            "issue": task.get("issue"),
            "repo": task.get("repo"),
            "evidence": [reason],
            "blocker": blocker,
            "next_action": "Reconcile durable/GitHub evidence before requeueing this same task.",
            "completed_at": utcnow().isoformat(),
        }
        write_json(watchdog_result_path(task_id), result)
        task["watchdog_observed_at"] = utcnow().isoformat()
    task["watchdog_blocker"] = blocker
    task["last_error"] = reason[-2000:]
    task["attempt_state"] = "delivery_uncertain"
    task.pop("result_status", None)
    task.pop("finished_at", None)
    move_task(path, BLOCKED, task)
    print(
        f"orphan_quarantined task={task_id} destination=blocked "
        f"age={age_seconds}s reason={reason}"
    )


def terminalize_from_result(
    path: Path,
    task: dict,
    result: dict,
    age_seconds: int,
) -> None:
    with parent_transition_guard(task) as all_terminal:
        _terminalize_from_result_locked(path, task, result, age_seconds, all_terminal)


def _terminalize_from_result_locked(
    path: Path, task: dict, result: dict, age_seconds: int, all_terminal: bool,
) -> None:
    status = str(result.get("status") or "")
    blocker = str(result.get("blocker") or "").strip()

    # An exact task_id + run_token is necessary but not sufficient
    # terminal evidence. Preserve the task-owned pane while the result
    # status is incomplete/invalid so recovery can continue fail-closed.
    if status not in {"completed", "blocked", "failed"}:
        _block_orphan_locked(
            path,
            task,
            reason=(
                "matching durable result has unsupported "
                f"status={status!r}"
            ),
            age_seconds=age_seconds,
        )
        return

    if not all_terminal:
        task["watchdog_blocker"] = "active_durable_children"
        task["recovery_action"] = "await_terminal_durable_children"
        task["attempt_state"] = "result_ready"
        task["delivery_reconcile_pending"] = True
        task.pop("result_status", None)
        task.pop("finished_at", None)
        move_task(path, BLOCKED, task)
        return

    if status == "completed" and (not blocker or blocker.lower() in {"none", "null"}):
        try:
            worker = _worker_bridge()
            if worker.modern_work_contract(task):
                worker.ROOT = ROOT
                accepted = worker._verify_root_completion(task, result)
            else:
                accepted = (verify_completion(ROOT, task, result) if verification_applies(task)
                            else {"level": "legacy_unverified_result"})
        except EvidenceError as exc:
            waiting = record_verification_failure(task, exc)
            if waiting:
                task["not_before"] = (utcnow() + timedelta(seconds=60)).isoformat()
            elif not cleanup_task_owned_pane(task):
                task["watchdog_cleanup_blocker"] = "task_session_cleanup_failed"
                task["verification_resolution"] = "needs_replan_cleanup_pending"
                task["attempt_state"] = "delivery_uncertain"
                task.pop("result_status", None)
            else:
                task.pop("watchdog_cleanup_blocker", None)
            move_task(path, BLOCKED, task)
            return
        task["completion_level"] = accepted["level"]
        task["completion_bundle_hash"] = accepted.get("bundle_hash", accepted.get("result_digest"))
        task["verification_status"] = ("accepted" if verification_applies(task)
                                       else "legacy_unverified")

    if not cleanup_task_owned_pane(task):
        task["watchdog_cleanup_blocker"] = (
            "task_session_cleanup_failed"
        )
        task["last_error"] = (
            "Exact durable result exists, but task-owned pane "
            "cleanup could not be proven; terminal queue "
            "transition is deferred."
        )
        task["attempt_state"] = "delivery_uncertain"

        # Never expose a terminal-looking result while queue
        # terminalization is deliberately deferred.
        task.pop("result_status", None)
        task.pop("finished_at", None)

        write_json(path, task)
        print(
            "orphan_terminal_cleanup_deferred "
            f"task={task.get('id')}"
        )
        return

    task.pop("watchdog_cleanup_blocker", None)
    task.pop("watchdog_blocker", None)
    task.pop("recovery_action", None)
    task.pop("delivery_reconcile_pending", None)
    task["watchdog_resolution"] = "exact_durable_result"
    task["watchdog_resolved_at"] = utcnow().isoformat()

    task["result_status"] = status
    task["finished_at"] = utcnow().isoformat()

    if blocker and blocker.lower() not in {"none", "null"}:
        task["attempt_state"] = "blocked"
        move_task(path, BLOCKED, task)
        destination = "blocked"

    elif status == "completed":
        task["attempt_state"] = "done"
        move_task(path, DONE, task)
        destination = "done"

    elif status == "blocked":
        task["attempt_state"] = "blocked"
        move_task(path, BLOCKED, task)
        destination = "blocked"

    elif status == "failed":
        task["attempt_state"] = "failed"
        move_task(path, FAILED, task)
        destination = "failed"

    print(
        f"orphan_terminalized task={task.get('id')} "
        f"destination={destination}"
    )
def recover_orphan_tasks(now: datetime | None = None) -> None:
    now = now or utcnow()
    active = active_worker_tasks()
    if not RUNNING.exists():
        return
    for path in sorted(RUNNING.glob("*.json")):
        try:
            resolved = path.resolve()
        except OSError:
            resolved = path
        if resolved in active:
            continue
        try:
            task = json.loads(path.read_text(encoding="utf-8"))
        except Exception as exc:
            age = int(max(0, now.timestamp() - path.stat().st_mtime))
            if age > 1800 + ORPHAN_GRACE_SECONDS:
                os.replace(path, BLOCKED / path.name)
                print(f"orphan_invalid_json_blocked file={path.name} error={exc}")
            continue

        ensure_live_task_bridge(path, task)

        if (
            task.get("watchdog_cleanup_blocker")
            == "task_session_cleanup_failed"
        ):
            result, _ = matching_result(task)
            if result is not None:
                terminalize_from_result(path, task, result, 0)
            continue

        if task.get("watchdog_blocker") == "orphaned_running_unknown_delivery":
            result, _ = matching_result(task)
            if result is not None:
                terminalize_from_result(path, task, result, 0)
            else:
                # Resume an interrupted quarantine transition. The marker may
                # already be durable in running/ if the previous watchdog was
                # interrupted after write_json() but before os.replace().
                with parent_transition_guard(task):
                    move_task(path, BLOCKED, task)
                print(
                    f"orphan_quarantine_resumed task={task.get('id')} "
                    "destination=blocked"
                )
            continue

        timeout = max(30, int(task.get("timeout_seconds") or 1800))
        age = int(max(0, (now - parse_started(task, path)).total_seconds()))
        if age <= timeout + ORPHAN_GRACE_SECONDS:
            continue
        result, state = matching_result(task)
        if result is not None:
            terminalize_from_result(path, task, result, age)
            continue

        # Close the dispatcher->worker startup race and the result-publication
        # race immediately before any watchdog mutation.
        if resolved in active_worker_tasks():
            continue
        result, state = matching_result(task)
        if result is not None:
            terminalize_from_result(path, task, result, age)
            continue

        block_orphan(
            path,
            task,
            reason=f"no matching worker after double-check; durable_result={state}",
            age_seconds=age,
        )


def reconcile_watchdog_blocked_tasks() -> None:
    """Promote exact late durable results without ever replaying blocked work."""
    if not BLOCKED.exists():
        return
    for path in sorted(BLOCKED.glob("*.json")):
        try:
            task = json.loads(path.read_text(encoding="utf-8"))
        except Exception:
            continue
        ensure_live_task_bridge(path, task)
        cleanup_quarantine = (task.get("watchdog_cleanup_blocker")
                              == "task_session_cleanup_failed")
        if (task.get("verification_resolution") == "needs_replan"
                or (task.get("watchdog_blocker") not in {"orphaned_running_unknown_delivery", "delivery_uncertain_requires_recovery", "active_durable_children"}
                and not task.get("delivery_reconcile_pending") and not cleanup_quarantine)):
            continue
        result, _ = matching_result(task)
        if result is None:
            with parent_transition_guard(task) as all_terminal:
                if task.get("watchdog_blocker") == "active_durable_children" and not all_terminal:
                    continue
                if task.get("delivery_reconcile_pending"):
                    try:
                        due = datetime.fromisoformat(str(task.get("not_before") or "").replace("Z", "+00:00"))
                    except ValueError:
                        due = utcnow()
                    if due <= utcnow():
                        observed = observe_task_execution(task)
                        count = min(int(task.get("delivery_reconcile_count") or 0) + 1,
                                    int(task.get("max_delivery_reconciles") or 12))
                        task["delivery_reconcile_count"] = count
                        task["not_before"] = datetime.fromtimestamp(
                            utcnow().timestamp() + min(300, 15 * (2 ** min(count, 4))), timezone.utc
                        ).isoformat()
                        if count >= int(task.get("max_delivery_reconciles") or 12):
                            task["attempt_state"] = "delivery_uncertain"
                            task["watchdog_blocker"] = "delivery_uncertain_requires_recovery"
                            task["recovery_action"] = ("await_exact_result_from_live_session" if observed in {"working", "blocked", "settled"}
                                                       else "inspect_session_and_external_evidence")
                        write_json(path, task)
            continue
        task.pop("delivery_reconcile_pending", None)
        terminalize_from_result(path, task, result, 0)


def reconcile_verification_pending() -> None:
    """Collect late CI/review evidence without dispatching another execution."""
    if not BLOCKED.exists():
        return
    active = active_worker_tasks()
    for path in sorted(BLOCKED.glob("*.json")):
        try:
            task = json.loads(path.read_text(encoding="utf-8"))
            due = task.get("not_before")
            waiting = (task.get("attempt_state") == "verification_pending"
                       or task.get("watchdog_cleanup_blocker") == "task_session_cleanup_failed"
                       or task.get("watchdog_blocker") == "task_session_cleanup_failed")
            if (not waiting or task.get("verification_resolution") == "needs_replan"
                    or path.resolve() in active
                    or (due and datetime.fromisoformat(due.replace("Z", "+00:00")) > utcnow())):
                continue
        except (OSError, ValueError, TypeError):
            continue
        result, _ = matching_result(task)
        if result is not None:
            terminalize_from_result(path, task, result, 0)


def run_herdr(args: list[str], timeout: float = 15.0) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        [str(HERDR), *args],
        text=True,
        capture_output=True,
        timeout=timeout,
        env=ENV,
    )


def is_codex_update_dialog(text: str) -> bool:
    lines = [line.strip() for line in text.replace("\r", "").splitlines() if line.strip()]
    if len(lines) < 5:
        return False

    # The interactive updater menu must be the current bottom-of-screen UI,
    # not historical scrollback or text quoted by a task.
    if lines[-1] != "enter continue · esc skip":
        return False
    if not lines[-2].startswith("3. Skip until next version"):
        return False
    if lines[-3] != "2. Skip":
        return False
    if not lines[-4].startswith("› 1. Update now"):
        return False

    context = lines[max(0, len(lines) - 10):-4]
    return any(
        line.startswith("Update available") or "Update available ·" in line
        for line in context
    )


def recover_codex_update_dialogs() -> None:
    listed = run_herdr(["agent", "list"])
    if listed.returncode != 0:
        print(f"codex_dialog_list_failed rc={listed.returncode}")
        return
    try:
        payload = json.loads((listed.stdout or "").strip().splitlines()[-1])
        agents = ((payload.get("result") or {}).get("agents") or [])
    except Exception as exc:
        print(f"codex_dialog_list_invalid error={exc}")
        return
    for row in agents:
        if not isinstance(row, dict) or row.get("agent") != "codex":
            continue
        if row.get("agent_status") != "idle" or row.get("interactive_ready") is not True:
            continue
        # The updater is shown before the full Codex TUI takes over the pane.
        # Detection is intentionally read-only: the watchdog reports the stall
        # but never injects keys into a TUI that may have transitioned meanwhile.
        title = str(row.get("terminal_title_stripped") or "")
        if not title.startswith("agentops@"):
            continue
        name = str(row.get("name") or "")
        if not name:
            continue
        screen = run_herdr(["agent", "read", name])
        text = (screen.stdout or "") + (screen.stderr or "")
        if screen.returncode != 0 or not is_codex_update_dialog(text):
            continue
        print(f"codex_update_dialog_detected agent={name}")


def main() -> int:
    for action in (
        recover_orphan_tasks,
        reconcile_watchdog_blocked_tasks,
        reconcile_verification_pending,
        recover_codex_update_dialogs,
    ):
        try:
            action()
        except Exception as exc:
            print(f"recovery_error action={action.__name__} error={exc}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
