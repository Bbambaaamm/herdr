#!/bin/bash
set -u

STATE=/home/agentops/.local/state/agent-stack
BIN_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
ENSURE="$BIN_DIR/agent-stack-ensure"
RECOVERY="$BIN_DIR/agent-stack-recovery"
MAINTENANCE="$BIN_DIR/hermes-maintenance"
mkdir -p "$STATE"

exec 9>"$STATE/watchdog.lock"
if ! /usr/bin/flock -n 9; then
  exit 0
fi

echo "$(date -Is) watchdog started release_bin=$BIN_DIR" >> "$STATE/watchdog.log"

while true; do
  /bin/sleep 20
  /usr/bin/flock -n "$STATE/ensure.lock" "$ENSURE" >> "$STATE/watchdog.log" 2>&1 || true
  /usr/bin/flock -n "$STATE/recovery.lock" "$RECOVERY" >> "$STATE/watchdog.log" 2>&1 || true
  /usr/bin/flock -n "$STATE/maintenance.lock" "$MAINTENANCE" >> "$STATE/watchdog.log" 2>&1 || true
  /bin/sleep 40
done
