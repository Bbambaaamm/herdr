#!/usr/bin/env python3
import ctypes
import fcntl
import json
import os
import signal
import stat
import subprocess
import sys
import time
import uuid
from datetime import datetime, timezone
from pathlib import Path

HOME = Path("/home/agentops")
BIN = Path(__file__).resolve().parent
WORKER = BIN / "agent-task-worker"
sys.path.insert(0, str(BIN.parents[1]))
from herdr.host_configuration import host_entrypoint_command
from herdr.launch_environment import sanitize_environment
from herdr.policy_launch import process_start_ticks
from herdr.recovery_unknown import held as terminal_unknown_hold
ROOT = HOME / ".local/state/agent-stack/tasks"
PENDING = ROOT / "pending"
RUNNING = ROOT / "running"
LOG = HOME / ".local/state/agent-stack/task-dispatch.log"
DISPATCH_LOCK = ROOT / "dispatcher.lock"

ADMISSION_TIMEOUT = 15.0
LIBC = ctypes.CDLL(None, use_errno=True)

ENV = os.environ.copy()
ENV["HOME"] = str(HOME)
ENV["PATH"] = f"{HOME}/.local/node24/bin:{HOME}/.local/bin:/usr/local/bin:/usr/bin:/bin"

def log(message: str) -> None:
    line = f"{datetime.now(timezone.utc).isoformat(timespec='seconds')} {message}"
    with LOG.open("a", encoding="utf-8") as handle:
        handle.write(line + "\n")


def write_json(path: Path, data: dict) -> None:
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)


def parse_time(value: str | None) -> datetime:
    if not value:
        return datetime.min.replace(tzinfo=timezone.utc)
    return datetime.fromisoformat(value.replace("Z", "+00:00")).astimezone(timezone.utc)

def worker_running() -> bool:
    # Process check closes the race between Popen() and the worker acquiring worker.lock.
    proc = subprocess.run(
        ["/usr/bin/pgrep", "-f", "[a]gent-task-worker"],
        text=True,
        capture_output=True,
        env=ENV,
    )
    if proc.returncode == 0:
        return True
    if proc.returncode != 1:
        raise RuntimeError("worker_process_probe_failed")
    # Probe the SAME private inode used by legacy_admission_guard. The flock
    # CLI creates a missing file as 0666 & umask (0644 on a normal host), which
    # makes the worker correctly reject an otherwise fresh task queue.
    root = ROOT.absolute()
    if root.resolve(strict=True) != root:
        raise RuntimeError("worker_lock_root")
    directory = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    fd = None
    try:
        info = os.fstat(directory)
        if info.st_uid != os.getuid() or info.st_mode & 0o022:
            raise RuntimeError("worker_lock_root")
        fd = os.open("worker.lock", os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW |
                     os.O_CLOEXEC | os.O_NONBLOCK, 0o600, dir_fd=directory)
        held = os.fstat(fd)
        if (not stat.S_ISREG(held.st_mode) or held.st_uid != os.getuid()
                or stat.S_IMODE(held.st_mode) != 0o600 or held.st_nlink != 1):
            raise RuntimeError("worker_lock_metadata")
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return True
        after = os.fstat(fd)
        if (not stat.S_ISREG(after.st_mode) or after.st_uid != os.getuid()
                or stat.S_IMODE(after.st_mode) != 0o600 or after.st_nlink != 1):
            raise RuntimeError("worker_lock_metadata")
        named = os.stat("worker.lock", dir_fd=directory, follow_symlinks=False)
        if (held.st_dev, held.st_ino) != (named.st_dev, named.st_ino):
            raise RuntimeError("worker_lock_changed")
        if (after.st_uid, after.st_mode, after.st_nlink) != (named.st_uid, named.st_mode, named.st_nlink):
            raise RuntimeError("worker_lock_metadata")
        return False
    finally:
        if fd is not None:
            os.close(fd)
        os.close(directory)

def due_tasks() -> list[Path]:
    current = datetime.now(timezone.utc)
    due: list[tuple[int, datetime, Path]] = []
    for path in sorted(PENDING.glob("*.json")):
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
            if terminal_unknown_hold(data):
                continue
            when = parse_time(data.get("not_before"))
            priority = int(data.get("priority", 50))
        except Exception as exc:
            log(f"invalid task {path.name}: {exc}")
            continue
        if when <= current:
            due.append((priority, when, path))
    return [path for _, _, path in sorted(due, key=lambda item: (item[0], item[1], item[2].name))]

def launch(path: Path, dry_run: bool = False) -> int:
    if dry_run:
        print(path)
        return 0
    if worker_running():
        log("worker already active")
        return 0

    from herdr.ownership_epoch import legacy_admission_guard
    # The liveness probe is not an admission capability. Keep the existing
    # epoch's shared descriptor alive through claim and worker acknowledgement.
    # The new worker takes its own SH lock; legacy EX workers stay excluded.
    with legacy_admission_guard(ROOT):
        return _launch_with_epoch(path)


def quarantine_unstarted_claim(running: Path, claimed: bytes, reason: str) -> bool:
    # Only the exact, untouched top-level claim can be classified as unstarted.
    # A worker-written identity/session, existing result or concurrent change
    # requires reconciliation; never erase it or schedule another attempt.
    try:
        current = running.read_bytes()
    except FileNotFoundError:
        return False
    if current != claimed:
        return False
    task = json.loads(claimed)
    if (any(key in task for key in ("run_token", "execution_session", "parent_task_id"))
            or (ROOT / "results" / running.name).exists()):
        return False
    target = ROOT / "blocked" / running.name
    if target.exists():
        raise RuntimeError("dispatch_startup_blocked_destination_exists")
    task.update(attempt_state="blocked", blocker="worker_startup_denied",
                last_error=reason, dispatch_reconciliation_required=True,
                automatic_retry_allowed=False)
    write_json(running, task)
    os.replace(running, target)
    log(f"worker startup denied for {task['id']}; retained in blocked without retry")

    return True


def pin_dispatch_parent(parent_pid: int) -> None:
    # Until its own epoch is acquired, an unadmitted child must die with this
    # dispatcher even if the dispatcher is SIGKILLed between fork and exec.
    if LIBC.prctl(1, signal.SIGKILL, 0, 0, 0) != 0 or os.getppid() != parent_pid:
        os._exit(125)


def stop_unadmitted_child(proc) -> None:
    if proc.poll() is None:
        proc.terminate()
        try:
            proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait(timeout=5)


def current_dispatch_state(running: Path):
    try:
        return json.loads(running.read_text(encoding="utf-8"))
    except FileNotFoundError:
        # A safely retained pending/blocked/done transition can race polling.
        return None


def fresh_dispatch_ack(task, nonce, pid, start_ticks, parent_pid) -> bool:
    return (start_ticks is not None and isinstance(task, dict)
            and task.get("dispatch_admission") == {"nonce": nonce, "pid": pid,
                "start_ticks": start_ticks, "parent_pid": parent_pid})


def await_dispatch_admission(proc, running, claimed, nonce, parent_pid) -> int:
    try:
        start_ticks = process_start_ticks(proc.pid)
    except (OSError, ValueError):
        start_ticks = None
    deadline = time.monotonic() + ADMISSION_TIMEOUT
    while True:
        status = proc.poll()
        current = current_dispatch_state(running)
        acknowledged = fresh_dispatch_ack(current, nonce, proc.pid, start_ticks, parent_pid)
        if status is not None:
            unstarted = quarantine_unstarted_claim(
                running, claimed, f"worker exited without admitted task state rc={status}")
            log(f"worker for {running.stem} settled during admission rc={status}")
            return 0 if status == 0 and not unstarted and (current is None or acknowledged) else 1
        if acknowledged:
            return 0
        if time.monotonic() >= deadline:
            # Reap this exact child BEFORE releasing the epoch. A race with a
            # newly written acknowledgement never permits rollback: the exact
            # original claim comparison preserves all worker-written state.
            stop_unadmitted_child(proc)
            quarantine_unstarted_claim(running, claimed, "worker admission timed out; owned child reaped")
            log(f"worker admission for {running.stem} timed out; reconcile without retry")
            return 1
        time.sleep(0.05)


def _launch_with_epoch(path: Path) -> int:
    task = json.loads(path.read_text(encoding="utf-8"))
    if terminal_unknown_hold(task):
        return 1
    task_id = str(task["id"])
    running = RUNNING / f"{task_id}.json"
    if running.exists():
        log(f"refuse duplicate running task {task_id}")
        return 1

    # Select the protected host launch before any queue claim or state write.
    command = host_entrypoint_command("agent-stack/bin/agent-task-worker", [str(running)],
                                      legacy_command=[str(WORKER), str(running)])
    worker_env = {key: value for key, value in sanitize_environment(ENV).items()
                  if not key.startswith("PYTHON")}

    # Refresh ownership time before entering running/. Old attempt timestamps
    # must never make a freshly claimed task look orphaned to the watchdog.
    nonce, parent_pid = uuid.uuid4().hex, os.getpid()
    task["dispatch_admission_nonce"] = nonce
    task["dispatch_admission_parent_pid"] = parent_pid
    task.pop("dispatch_admission", None)
    task["dispatch_claimed_at"] = datetime.now(timezone.utc).isoformat()
    write_json(path, task)
    os.replace(path, running)
    log(f"launch {task_id} priority={task.get('priority', 50)}")
    claimed = running.read_bytes()
    try:
        with (ROOT / "logs" / f"{task_id}.launcher.log").open("ab") as handle:
            proc = subprocess.Popen(
                command, stdout=handle, stderr=subprocess.STDOUT,
                env=worker_env, start_new_session=True, close_fds=True,
                preexec_fn=lambda: pin_dispatch_parent(parent_pid),
            )
    except OSError as exc:
        quarantine_unstarted_claim(running, claimed, f"worker spawn failed: {exc}")
        raise

    try:
        return await_dispatch_admission(proc, running, claimed, nonce, parent_pid)
    except BaseException:
        stop_unadmitted_child(proc)
        raise

def main() -> int:
    dry_run = "--dry-run" in sys.argv
    lock_fd = os.open(DISPATCH_LOCK, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 0
        tasks = due_tasks()
        if not tasks:
            return 0
        return launch(tasks[0], dry_run=dry_run)
    finally:
        os.close(lock_fd)

if __name__ == "__main__":
    raise SystemExit(main())
