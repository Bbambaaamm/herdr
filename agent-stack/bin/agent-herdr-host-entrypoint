#!/usr/bin/env python3
"""Root-published host entrypoint; invoke with the pinned Python -I -B.

This wrapper runs an existing host entrypoint, not an agent or a new scheduler.
The privileged plan authority never runs mutable repository files as root.
"""
import ctypes
from pathlib import Path
import runpy
import sys

libc = ctypes.CDLL(None, use_errno=True)
if libc.prctl(4, 0, 0, 0, 0) != 0 or libc.prctl(3, 0, 0, 0, 0) != 0:
    raise SystemExit("non-dumpable host process required")
root = Path(__file__).resolve(strict=True).parents[2]
sys.path.insert(0, str(root))
from herdr.launch_plan_issuer import _policy, HOST_ENTRYPOINT, require
from herdr.host_configuration import _tree
from herdr.host_bootstrap import PYTHON_TARGET, PYTHON_EXECUTABLE

issuer, policy = _policy()
require(sys.flags.isolated and sys.dont_write_bytecode, "isolated host interpreter required")
require(root == Path(policy["code"]["source"])
        and len(sys.argv) >= 2 and sys.argv[1] in issuer["entrypoints"], "approved host entrypoint required")
python = next(row for row in policy["runtime"] if row["target"] == str(PYTHON_TARGET))
require(Path(sys.executable) == Path(python["source"]) / PYTHON_EXECUTABLE,
        "pinned host interpreter required")
for definition in (policy["code"], *policy["runtime"]):
    snapshot = _tree(definition, immutable=True).freeze(Path(policy["storage"]), ())
    snapshot.close()
target = root / sys.argv[1]
# Existing worker scripts import helpers beside their entrypoint. Restore that
# script import directory only after its complete immutable release is verified.
sys.path.insert(0, str(target.parent))
sys.argv = [str(target), *sys.argv[2:]]
runpy.run_path(str(target), run_name="__main__")
