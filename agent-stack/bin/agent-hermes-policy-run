#!/usr/bin/python3 -I -S
"""Fixed-path Hermes bootstrap reached through the pane's policy-bin PATH.

Production authority comes from the host-pinned bundle inode on a read-only
bind and exact host-controlled pane identity. Hermes argv/environment cannot
select a grant, key, policy module, or executable.
"""
from __future__ import annotations

import importlib
import hashlib
import os
import re
import stat
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Any

BUNDLE_PATH = Path("/run/herdr-policy/grant.bundle.json")
POLICY_CODE_ROOT = Path("/run/herdr/policy-code")
HERMES_ROOT = Path("/home/agentops/.hermes/hermes-agent")
HERMES_HEAD = "ee5ee84a345204a3b1d6ef6ba1ab747e602867b9"
HERMES_SOURCE_SHA256 = "525219e866137f43c8c8b068488e07d97f14529d2d67497cd52fbfd1197da4f4"
PYTHON_PATH = Path("/home/agentops/.local/share/uv/python/cpython-3.11.16-linux-x86_64-gnu/bin/python3.11")
PYTHON_SHA256 = "1e761eb19d6f2594ab8dc64bd99ad4e1753589f3bf1ec199e4eef3aaa21e3930"
PYTHON_STDLIB_SHA256 = "330e97044fcb6873bc76ab37b63bfcd8c9a081d64d285adea164d3f72b548c2e"
SITE_SHA256 = "61bbcc21c6f429974c9e6d10258a93056b439cb3a4afd5548e112694f5e0fea0"
_INTERPRETER_FD_ENV = "HERDR_VERIFIED_PYTHON_FD"
_SOURCE_EXECUTOR = f"hermes:0.21.5:sha256:{HERMES_SOURCE_SHA256}"
HERMES_EXECUTOR = "hermes:0.21.5:sha256:" + hashlib.sha256(
    b"herdr-hermes-executor-v2\0" + bytes.fromhex(HERMES_SOURCE_SHA256)
    + bytes.fromhex(PYTHON_SHA256) + bytes.fromhex(PYTHON_STDLIB_SHA256)
    + bytes.fromhex(SITE_SHA256)
).hexdigest()
IDENTITY_ENV = {
    "consumer": "HERDR_POLICY_CONSUMER",
    "agent_id": "HERDR_POLICY_AGENT_ID",
    "parent_agent_id": "HERDR_POLICY_PARENT_AGENT_ID",
    "parent_task_id": "HERDR_POLICY_PARENT_TASK_ID",
    "task_id": "HERDR_POLICY_TASK_ID",
    "run_token": "HERDR_POLICY_RUN_TOKEN",
    "fencing_token": "HERDR_POLICY_FENCING_TOKEN",
}


def _within(path: Path, root: Path) -> bool:
    return path == root or root in path.parents


def _unescape_mount(value: str) -> str:
    for old, new in ((r"\040", " "), (r"\011", "\t"), (r"\012", "\n"), (r"\134", "\\")):
        value = value.replace(old, new)
    return value


def _covering_mount(path: Path) -> tuple[Path, set[str]]:
    """Return the longest mount covering path from this process' mount namespace."""
    target = path.absolute()
    best: tuple[Path, set[str]] | None = None
    try:
        rows = Path("/proc/self/mountinfo").read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        raise SystemExit("cannot verify policy mount namespace") from exc
    for line in rows:
        fields = line.split(" - ", 1)[0].split()
        if len(fields) < 6:
            continue
        mount = Path(_unescape_mount(fields[4]))
        try:
            covered = target == mount or mount in target.parents
        except ValueError:
            covered = False
        if covered and (best is None or len(mount.parts) > len(best[0].parts)):
            best = (mount, set(fields[5].split(",")))
    if best is None:
        raise SystemExit(f"no mount covers security path: {path}")
    return best


def _require_production_mount(path: Path, *, exact: bool = False) -> None:
    mount, options = _covering_mount(path)
    if "ro" not in options or mount == Path("/") or (exact and mount != path):
        raise SystemExit(f"security path is not on a dedicated read-only trust mount: {path}")


def _reset_import_path(policy_code_root: Path, hermes_root: Path) -> None:
    """Drop cwd/PYTHONPATH/user-site influence before importing policy or Hermes code."""
    os.environ.pop("PYTHONPATH", None)
    os.environ.pop("PYTHONHOME", None)
    os.environ["PYTHONNOUSERSITE"] = "1"
    base = Path(sys.base_prefix).resolve()
    trusted: list[str] = []
    for raw in list(sys.path):
        if not raw:
            continue
        try:
            candidate = Path(raw).resolve()
        except OSError:
            continue
        if _within(candidate, base):
            text = str(candidate)
            if text not in trusted:
                trusted.append(text)
    site = hermes_root / "venv/lib/python3.11/site-packages"
    sys.path[:] = [str(policy_code_root.resolve()), str(hermes_root.resolve()), str(site), *trusted]


def _sha256_fd(fd: int) -> str:
    digest = hashlib.sha256()
    os.lseek(fd, 0, os.SEEK_SET)
    while chunk := os.read(fd, 1024 * 1024):
        digest.update(chunk)
    return digest.hexdigest()


def _verified_interpreter_fd() -> int:
    """Open and hash the executable that will be passed to execve."""
    fd = os.open(PYTHON_PATH, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode) or _sha256_fd(fd) != PYTHON_SHA256:
            raise SystemExit("audited Python binary differs from executor pin")
        return fd
    except BaseException:
        os.close(fd)
        raise


def _exec_verified_interpreter(script: Path, args: list[str]) -> None:
    fd = _verified_interpreter_fd()
    if _digest_site_packages(PYTHON_PATH.parents[1] / "lib/python3.11") != PYTHON_STDLIB_SHA256:
        raise SystemExit("audited Python standard library differs from executor pin")
    os.set_inheritable(fd, True)
    env = dict(os.environ)
    env[_INTERPRETER_FD_ENV] = str(fd)
    path = f"/proc/self/fd/{fd}"
    os.execve(path, [path, "-I", "-S", str(script), *args], env)


def _verify_runtime(hermes_root: Path) -> None:
    """Stage two: recheck the inherited ELF and closed import surface."""
    if not sys.flags.isolated or not sys.flags.no_site or sys.version_info[:2] != (3, 11):
        raise SystemExit("audited Python requires isolated no-site startup")
    try:
        fd = int(os.environ.pop(_INTERPRETER_FD_ENV))
        inherited = os.fstat(fd)
        active = os.stat("/proc/self/exe")
        if (inherited.st_dev, inherited.st_ino) != (active.st_dev, active.st_ino):
            raise ValueError("active interpreter differs from held executable")
        if not stat.S_ISREG(inherited.st_mode) or _sha256_fd(fd) != PYTHON_SHA256:
            raise ValueError("audited interpreter bytes changed")
        if os.path.realpath(f"/proc/self/fd/{fd}") != str(PYTHON_PATH):
            raise ValueError("interpreter path changed")
    except (OSError, ValueError, TypeError) as exc:
        raise SystemExit("cannot verify inherited Hermes interpreter") from exc
    finally:
        if 'fd' in locals():
            try:
                os.close(fd)
            except OSError:
                pass
    site = hermes_root / "venv/lib/python3.11/site-packages"
    if _digest_site_packages(PYTHON_PATH.parents[1] / "lib/python3.11") != PYTHON_STDLIB_SHA256:
        raise SystemExit("audited Python standard library differs from executor pin")
    if _digest_site_packages(site) != SITE_SHA256:
        raise SystemExit("venv import surface differs from executor pin")
    # CPython never consults conventional __pycache__ with this fresh prefix.
    sys.pycache_prefix = tempfile.mkdtemp(prefix=f"herdr-pycache-{os.getpid()}-", dir="/tmp")


def _digest_site_packages(site: Path) -> str:
    if site.is_symlink() or not site.is_dir():
        raise SystemExit("venv import surface unavailable")
    digest = hashlib.sha256()
    for path in sorted(site.rglob("*"), key=lambda p: p.relative_to(site).as_posix()):
        if "__pycache__" in path.relative_to(site).parts:
            continue
        if path.suffix == ".pyc":
            raise SystemExit("sourceless venv bytecode is forbidden")
        if path.is_symlink():
            raise SystemExit("venv import surface contains a symlink")
        if not path.is_file() and not path.is_dir():
            raise SystemExit("venv import surface contains a special file")
        if path.is_file():
            if not stat.S_ISREG(path.stat().st_mode):
                raise SystemExit("venv import surface contains a special file")
            digest.update(path.relative_to(site).as_posix().encode() + b"\0")
            digest.update(hashlib.sha256(path.read_bytes()).digest())
    return digest.hexdigest()


def _require_module_origin(module: Any, root: Path, label: str) -> None:
    source = getattr(module, "__file__", None)
    if not isinstance(source, str):
        raise SystemExit(f"{label} import has no source identity")
    try:
        resolved = Path(source).resolve(strict=True)
        trusted = root.resolve(strict=True)
    except OSError as exc:
        raise SystemExit(f"{label} import source unavailable") from exc
    if not _within(resolved, trusted):
        raise SystemExit(f"{label} import escaped trusted root")


def _verify_hermes_build(root: Path) -> str:
    """Verify actual tracked source against the pinned clean Git build before import."""
    try:
        project = (root / "pyproject.toml").read_text(encoding="utf-8")
        version = re.search(r'(?m)^version = "([^"]+)"$', project).group(1)
        env = {"PATH": "/usr/bin:/bin", "HOME": "/nonexistent",
               "GIT_CONFIG_NOSYSTEM": "1", "GIT_CONFIG_GLOBAL": "/dev/null"}
        def git(*args: str) -> str:
            return subprocess.run(["/usr/bin/git", "-C", str(root), *args],
                                  env=env, capture_output=True, text=True,
                                  check=True, timeout=30).stdout.strip()
        head = git("rev-parse", "HEAD")
        if head != HERMES_HEAD:
            raise ValueError("Hermes revision changed")
        names = subprocess.run(["/usr/bin/git", "-C", str(root), "ls-files", "-z"],
                               env=env, capture_output=True, check=True, timeout=30).stdout
        digest = hashlib.sha256()
        tracked = set()
        for name in names.split(b"\0"):
            if name:
                tracked.add(os.fsdecode(name))
                digest.update(name + b"\0")
                digest.update(hashlib.sha256((root / os.fsdecode(name)).read_bytes()).digest())
        if git("status", "--porcelain", "--untracked-files=all"):
            raise ValueError("Hermes source tree is not clean")
        for path in root.rglob("*"):
            relative = path.relative_to(root)
            if any(part in {"venv", ".git", "__pycache__", "node_modules"} for part in relative.parts):
                continue
            if path.suffix in {".py", ".pyc", ".so", ".pth"} and relative.as_posix() not in tracked:
                raise ValueError("untracked importable Hermes file")
    except (OSError, AttributeError, ValueError, subprocess.SubprocessError) as exc:
        raise SystemExit("cannot verify audited Hermes build") from exc
    actual = f"hermes:{version}:sha256:{digest.hexdigest()}"
    if actual != _SOURCE_EXECUTOR:
        raise SystemExit("Hermes build differs from signed executor pin")
    return HERMES_EXECUTOR


def bootstrap(
    hermes_args: list[str],
    *,
    bundle_path: Path = BUNDLE_PATH,
    policy_code_root: Path = POLICY_CODE_ROOT,
    hermes_root: Path = HERMES_ROOT,
) -> int:
    """Verify host authority and install guards before Hermes can make a model call."""
    production = (
        bundle_path == BUNDLE_PATH
        and policy_code_root == POLICY_CODE_ROOT
        and hermes_root == HERMES_ROOT
    )
    if production:
        _require_production_mount(bundle_path, exact=True)
        _require_production_mount(policy_code_root)

    if production:
        _verify_runtime(hermes_root)
    if policy_code_root.is_symlink() or not policy_code_root.is_dir():
        raise SystemExit("trusted policy code root unavailable")
    executor = _verify_hermes_build(hermes_root)

    _reset_import_path(policy_code_root, hermes_root)

    security_module = importlib.import_module("herdr.security")
    guard_module = importlib.import_module("herdr.hermes_guard")
    _require_module_origin(security_module, policy_code_root, "herdr.security")
    _require_module_origin(guard_module, policy_code_root, "herdr.hermes_guard")

    try:
        identity_fields = {name: os.environ[env_name] for name, env_name in IDENTITY_ENV.items()}
        identity_fields["fencing_token"] = int(identity_fields["fencing_token"])
        identity = security_module.InvocationIdentity.from_dict(identity_fields)
        grant = security_module.load_policy_bundle(
            bundle_path,
            identity,
        )
        if tuple(grant.scope.executors) != (executor,):
            raise security_module.SecurityError("signed executor scope differs from audited Hermes build")
        guard = security_module.InvocationGuard(grant)
    except (security_module.SecurityError, KeyError, TypeError, ValueError) as exc:
        raise SystemExit(f"signed Herdr grant rejected: {exc}") from exc

    guard_module.install_hermes_guard(guard)

    hermes_main_module = importlib.import_module("hermes_cli.main")
    _require_module_origin(hermes_main_module, hermes_root, "hermes_cli.main")
    sys.argv = [str(hermes_root / "hermes"), *hermes_args]
    result = hermes_main_module.main()
    return 0 if result is None else int(result)


def main() -> int:
    # No policy path, identity, key, code root, or executable override is parsed from argv.
    if _INTERPRETER_FD_ENV not in os.environ:
        if Path(sys.executable).resolve() != Path("/usr/bin/python3").resolve() or not sys.flags.isolated or not sys.flags.no_site:
            raise SystemExit("bootstrap requires trusted system Python -I -S")
        _exec_verified_interpreter(POLICY_CODE_ROOT / "agent-stack/bin/agent-hermes-policy-run", sys.argv[1:])
    return bootstrap(sys.argv[1:])


if __name__ == "__main__":
    raise SystemExit(main())
