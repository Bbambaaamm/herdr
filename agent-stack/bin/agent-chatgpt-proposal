#!/usr/bin/env python3
"""Offline proposal renderer, with no intake/execution authority."""
import json
import os
import stat
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
from herdr.chatgpt_command import CommandProposal, ProposalDenied, MAX_BYTES


def main():
    if len(sys.argv) != 3 or sys.argv[1] != "--propose":
        print("usage: agent-chatgpt-proposal --propose INPUT.json", file=sys.stderr)
        return 2
    try:
        path = Path(sys.argv[2])
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
        try:
            info = os.fstat(fd)
            if not stat.S_ISREG(info.st_mode) or info.st_size > MAX_BYTES:
                raise ProposalDenied("invalid_request_file")
            raw = os.read(fd, MAX_BYTES + 1)
            if len(raw) != info.st_size:
                raise ProposalDenied("request_changed")
        finally:
            os.close(fd)
        proposal = CommandProposal.parse(raw)
        print(json.dumps(proposal.github_issue_proposal(), ensure_ascii=False, sort_keys=True))
        return 0
    except (OSError, ProposalDenied, UnicodeError):
        print("proposal_denied", file=sys.stderr)
        return 3


if __name__ == "__main__":
    sys.exit(main())
