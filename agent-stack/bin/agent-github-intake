""".strip()

    raise RuntimeError(f"enabled consumer has no safe prompt contract: {name}")


def _queue_issue_locked(consumer: dict, issue: dict, records: list[dict]) -> str:
    issue, admission = approved_revision(consumer, issue)
    number = issue["number"]
    task_id = f"github-{consumer['consumer']}-issue-{number}-approval-{admission['approval_id']}"
    previous = load_state().get(state_key(consumer["repository"], number), {})
    history = used_approvals(previous)
    if _requires_admission_reconciliation(previous):
        raise AdmissionDenied("intake-admission-reconciliation-required")
    if str(admission["approval_id"]) in history:
        return history[str(admission["approval_id"])]
    if any((record["task"].get("github_admission") or {}).get("approval_id") == admission["approval_id"]
           for record in records):
        return task_id
    if len(history) >= 1024:
        raise AdmissionDenied("intake-approval-history-full")
    prior = prior_evidence(records)
    task = {
        "id": task_id,
        "github_admission": admission,
        "kind": (
            "github_root_orchestration"
            if consumer.get("mode") == "root_only"
            else "github_issue_slice"
        ),
        "consumer": consumer["consumer"],
        "issue": number,
        "repo": consumer["repository"],
        "workspace": consumer["workspace"],
        "safety_profile": consumer["safety_profile"],
        "hermes_profile": consumer["hermes_profile"],
        "coordinator_agent": consumer["coordinator_agent"],
        "agent": consumer["coordinator_agent"],
        "priority": issue_priority(consumer, issue),
        "not_before": now().isoformat(),
        "timeout_seconds": 1800,
        "max_attempts": 4,
        "attempts": 0,
        "prompt": prompt_for(consumer, issue, prior),
    }
    if consumer["repository"] == "Bbambaaamm/herdr" and consumer.get("mode") != "root_only":
        task["work_contract_version"] = 1
        task["work_budget_version"] = 1
    elif consumer["repository"] == "Bbambaaamm/herdr":
        task["child_work_contract_version"] = 1
        task["child_work_budget_version"] = 1
    scope_fields = ("parent_role", "parent_tools", "parent_permissions", "worktree_root")
    if all(field in consumer for field in scope_fields):
        for field in scope_fields:
            task[field] = consumer[field]
    path = PENDING / f"{task_id}.json"
    scan_remaining()
    _consume_admission(consumer, issue, task_id, admission)
    # Once consumed, finish local durability; the scan deadline bounds admission/network work.
    publish_task(path, task, admission)
    _mark_admission_published(consumer, issue, task_id, admission)
    log(
        f"queued {consumer['repository']}#{number} as {task_id} "
        f"priority={task['priority']} coordinator={task['agent']}"
    )
    return task_id


def intervention_blocker(
    records: list[dict], *, allow_failed_replan: bool = False
) -> tuple[str, str] | None:
    if not records:
        return None
    latest = records[0]
    task = latest["task"]
    task_id = str(task.get("id") or "")
    if task.get("verification_resolution") == "needs_replan":
        return task_id, str(task.get("verification_next_action") or "verification requires replan")
    if task.get("attempt_state") == "verification_pending":
        return task_id, str(task.get("verification_status") or "verification_pending")
    result = result_for(task_id)
    blocker = str(result.get("blocker") or "")
    if blocker in {
        "github_write_auth_required",
        "user_action_required",
        "agent_interactive_input_required",
    }:
        return task_id, blocker
    if latest["state"] == "failed" and not allow_failed_replan:
        return task_id, str(task.get("last_error") or "failed")
    return None


def main() -> int:
    if sys.argv[1:2] == ["--approval-digest"]:
        if len(sys.argv) != 4 or not sys.argv[3].isdigit() or int(sys.argv[3]) <= 0:
            raise AdmissionDenied("approval-digest-arguments-invalid")
        repo, number = sys.argv[2], int(sys.argv[3])
        consumers = load_consumers()
        selected = [row for row in consumers if row["repository"] == repo
                    and (row["mode"] != "root_only" or row["root_issue"] == number)]
        if len(selected) != 1:
            raise AdmissionDenied("approval-digest-consumer-mismatch")
        authenticated_user()
        api = f"https://api.github.com/repos/{repo}"
        repository = fetch_json(api)
        issue = fetch_json(f"{api}/issues/{number}")
        digest = issue_revision(repo, repository, issue)
        if issue["number"] != number:
            raise AdmissionDenied("github-issue-selection-mismatch")
        proposed = {"action": "approve", "repository": repo, "issue_number": number,
                    "issue_id": issue["id"], "content_sha256": digest,
                    "expires_at": (now() + timedelta(minutes=30)).isoformat()}
        print(json.dumps({"read_only": True, "task_created": False,
                          "approval_body": APPROVAL_MARKER + json.dumps(proposed, sort_keys=True)}))
        return 0
    if sys.argv[1:] not in ([], ["--force"]):
        raise AdmissionDenied("intake-arguments-invalid")
    force = "--force" in sys.argv
    if not force and STAMP.exists() and time.time() - STAMP.stat().st_mtime < 300:
        return 0

    return scan_intake(load_consumers())


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:
        log(f"ERROR: {exc}")
        raise
