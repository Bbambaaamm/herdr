#!/usr/bin/env python3
import contextlib
import ctypes
import fcntl
import hashlib
import stat
import tempfile
import json
import subprocess
import os
import re
import sys
import time
from collections import defaultdict
from datetime import datetime, timedelta, timezone
from pathlib import Path

HOME = Path("/home/agentops")
ROOT = HOME / ".local/state/agent-stack/tasks"
PENDING = ROOT / "pending"
RESULTS = ROOT / "results"
STATE = ROOT / "github-intake-state.json"
STAMP = ROOT / "github-intake.stamp"
LOG = HOME / ".local/state/agent-stack/github-intake.log"
CONFIG = Path(
    os.environ.get(
        "HERDR_GITHUB_INTAKE_CONFIG",
        str(Path(__file__).resolve().parents[1] / "config/github-intake-consumers.json"),
    )
)
LEGACY_REPO = "Bbambaaamm/Autonomous-Quant-Lab"
ACTIVE_DIRS = ("pending", "running", "blocked")
TERMINAL_DIRS = ("done", "failed")
COOLDOWN_SECONDS = 300
SAFE_REPO = re.compile(r"^[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9_.-]{1,100}$")
APPROVAL_MARKER = "HERDR-ADMISSION-V1\n"
MAX_APPROVAL_AGE = 86400
MAX_COMMENTS = 1000
MAX_CONSUMERS = 64
SCAN_SECONDS = 24.0
GH_TIMEOUT_SECONDS = 5.0
_SCAN_DEADLINE = None
_SCAN_USER = None
_INTAKE_LOCK_OWNER = None


class AdmissionDenied(RuntimeError):
    """Redacted denial; issue content never supplies execution authority."""


class ScanExpired(AdmissionDenied):
    pass


SAFE_CONSUMER = re.compile(r"^[a-z0-9][a-z0-9-]{0,31}$")


def now() -> datetime:
    return datetime.now(timezone.utc)


def log(message: str) -> None:
    with LOG.open("a", encoding="utf-8") as handle:
        handle.write(f"{now().isoformat(timespec='seconds')} {message}\n")


def state_key(repo: str, issue: int | str) -> str:
    return f"{repo}#{int(issue)}"


def task_repo(task: dict) -> str:
    repo = task.get("repo")
    if isinstance(repo, str) and repo.count("/") == 1:
        return repo
    return LEGACY_REPO


def load_state() -> dict:
    if not STATE.exists():
        return {}
    try:
        raw = json.loads(STATE.read_text(encoding="utf-8"), object_pairs_hook=_json_object)
    except Exception as exc:
        raise AdmissionDenied("intake-state-unavailable") from exc
    if not isinstance(raw, dict):
        raise AdmissionDenied("intake-state-invalid")
    normalized = {}
    for key, value in raw.items():
        if not isinstance(key, str) or not isinstance(value, dict):
            raise AdmissionDenied("intake-state-row-invalid")
        if re.fullmatch(r"[1-9][0-9]*", key):
            repo, number = LEGACY_REPO, int(key)
        else:
            repo, sep, number_text = key.rpartition("#")
            if not sep or not SAFE_REPO.fullmatch(repo) or not re.fullmatch(r"[1-9][0-9]*", number_text):
                raise AdmissionDenied("intake-state-key-invalid")
            number = int(number_text)
        canonical = state_key(repo, number)
        if canonical in normalized:
            raise AdmissionDenied("intake-state-key-collision")
        row = dict(value)
        if ("repo" in row and row["repo"] != repo) or ("issue" in row and str(row["issue"]) != str(number)):
            raise AdmissionDenied("intake-state-identity-invalid")
        history = used_approvals(row)  # Validate closed/unselected rows too.
        _validate_admission_intent(row, history)
        row.setdefault("repo", repo)
        row.setdefault("issue", number)
        normalized[canonical] = row
    return normalized


def save_state(data: dict) -> None:
    _atomic_json(STATE, data)


def load_consumers() -> list[dict]:
    raw = json.loads(CONFIG.read_text(encoding="utf-8"))
    if raw.get("schema_version") != 1 or not isinstance(raw.get("consumers"), list):
        raise RuntimeError("invalid GitHub intake consumer registry")

    enabled: list[dict] = []
    seen_repos: set[str] = set()
    for entry in raw["consumers"]:
        if not isinstance(entry, dict):
            raise RuntimeError("invalid consumer registry row")
        consumer = str(entry.get("consumer") or "")
        repo = str(entry.get("repository") or "")
        mode = str(entry.get("mode") or "")
        if not SAFE_CONSUMER.fullmatch(consumer):
            raise RuntimeError(f"invalid consumer id: {consumer!r}")
        if not SAFE_REPO.fullmatch(repo):
            raise RuntimeError(f"invalid repository for {consumer}")
        if repo in seen_repos:
            raise RuntimeError(f"duplicate repository in intake registry: {repo}")
        seen_repos.add(repo)
        if mode not in {"all_open", "root_only"}:
            raise RuntimeError(f"unsupported intake mode for {consumer}: {mode}")
        if mode == "root_only":
            root_issue = entry.get("root_issue")
            if type(root_issue) is not int or root_issue <= 0:
                raise RuntimeError(f"invalid root issue for {consumer}")
        if entry.get("enabled") is not True:
            continue
        if entry.get("admission") != {"signal": "maintainer-comment-v1", "max_age_seconds": MAX_APPROVAL_AGE}:
            raise RuntimeError(f"trusted admission policy required for {consumer}")
        for field in (
            "coordinator_agent",
            "workspace",
            "safety_profile",
            "hermes_profile",
        ):
            if not str(entry.get(field) or "").strip():
                raise RuntimeError(f"missing {field} for enabled consumer {consumer}")
        enabled.append(entry)
        if len(enabled) > MAX_CONSUMERS:
            raise RuntimeError("enabled consumer registry limit exceeded")
    return enabled


def _json_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise AdmissionDenied("duplicate-json-field")
        result[key] = value
    return result


def fetch_json(url: str):
    prefix = "https://api.github.com/"
    if not isinstance(url, str) or not url.startswith(prefix) or any(c in url for c in "\r\n#"):
        raise AdmissionDenied("github-endpoint-invalid")
    endpoint = url[len(prefix):]
    if not endpoint or endpoint.startswith("-"):
        raise AdmissionDenied("github-endpoint-invalid")
    try:
        result = subprocess.run(
            ["gh", "api", "--hostname", "github.com", "--method", "GET", endpoint],
            stdin=subprocess.DEVNULL, capture_output=True, timeout=scan_remaining(), check=False,
        )
    except subprocess.TimeoutExpired as exc:
        scan_remaining()
        raise AdmissionDenied("github-request-timeout") from exc
    if result.returncode != 0 or not result.stdout or len(result.stdout) > 8388608:
        raise AdmissionDenied("github-auth-or-response-unavailable")
    try:
        value = json.loads(result.stdout, object_pairs_hook=_json_object)
    except (ValueError, TypeError) as exc:
        raise AdmissionDenied("github-response-invalid") from exc
    scan_remaining()
    return value


def _user(value):
    if (not isinstance(value, dict) or type(value.get("id")) is not int or value["id"] <= 0
            or value.get("type") != "User" or not isinstance(value.get("login"), str)
            or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9-]{0,38}", value["login"])):
        raise AdmissionDenied("github-user-unverifiable")
    return value["id"], value["login"]


def authenticated_user():
    global _SCAN_USER
    if _SCAN_DEADLINE is not None and _SCAN_USER is not None:
        return _SCAN_USER
    user = _user(fetch_json("https://api.github.com/user"))
    if _SCAN_DEADLINE is not None:
        _SCAN_USER = user
    return user


def _date(value):
    try:
        result = datetime.fromisoformat(value.replace("Z", "+00:00"))
        if result.tzinfo is None:
            raise ValueError("timezone missing")
        return result.astimezone(timezone.utc)
    except (AttributeError, TypeError, ValueError) as exc:
        raise AdmissionDenied("github-time-unverifiable") from exc


def issue_revision(repo, repository, issue):
    if (not isinstance(repository, dict) or not isinstance(repository.get("full_name"), str)
            or repository["full_name"].lower() != repo.lower()
            or type(repository.get("id")) is not int or repository["id"] <= 0
            or not isinstance(issue, dict) or type(issue.get("number")) is not int
            or issue["number"] <= 0 or type(issue.get("id")) is not int or issue["id"] <= 0
            or issue.get("state") != "open" or "pull_request" in issue
            or not isinstance(issue.get("title"), str) or not 0 < len(issue["title"]) <= 256
            or "body" not in issue or (issue["body"] is not None and not isinstance(issue["body"], str))
            or len(issue["body"] or "") > 12000 or type(issue.get("comments")) is not int
            or not 0 <= issue["comments"] <= MAX_COMMENTS):
        raise AdmissionDenied("github-issue-incomplete-or-ineligible")
    api = f"https://api.github.com/repos/{repo}"
    number = issue["number"]
    if (issue.get("repository_url") != api or issue.get("url") != f"{api}/issues/{number}"
            or issue.get("html_url") != f"https://github.com/{repo}/issues/{number}"):
        raise AdmissionDenied("github-issue-repository-mismatch")
    if _date(issue.get("created_at")) > _date(issue.get("updated_at")):
        raise AdmissionDenied("github-issue-revision-invalid")
    content = {"version": 1, "repository": repo, "repository_id": repository["id"],
               "issue_id": issue["id"], "number": number, "state": issue["state"],
               "title": issue["title"], "body": issue["body"]}
    digest = hashlib.sha256(json.dumps(content, sort_keys=True, ensure_ascii=False,
                                       separators=(",", ":")).encode()).hexdigest()
    return digest


def approved_revision(consumer, issue):
    if consumer.get("admission") != {"signal": "maintainer-comment-v1", "max_age_seconds": MAX_APPROVAL_AGE}:
        raise AdmissionDenied("trusted-admission-policy-required")
    authenticated_user()
    repo = consumer["repository"]
    number = issue.get("number")
    if type(number) is not int or number <= 0 or (consumer["mode"] == "root_only" and number != consumer["root_issue"]):
        raise AdmissionDenied("github-issue-selection-mismatch")
    api = f"https://api.github.com/repos/{repo}"
    repository = fetch_json(api)
    current = fetch_json(f"{api}/issues/{number}")
    digest = issue_revision(repo, repository, current)
    if current["number"] != number:
        raise AdmissionDenied("github-issue-selection-mismatch")
    comments = []
    for page in range(1, (current["comments"] + 99) // 100 + 1):
        rows = fetch_json(f"{api}/issues/{number}/comments?per_page=100&page={page}")
        expected = min(100, current["comments"] - len(comments))
        if not isinstance(rows, list) or len(rows) != expected:
            raise AdmissionDenied("github-comments-incomplete")
        comments.extend(rows)
    ids = set()
    for comment in comments:
        if (not isinstance(comment, dict) or type(comment.get("id")) is not int or comment["id"] <= 0
                or comment["id"] in ids or not isinstance(comment.get("body"), str)
                or comment.get("issue_url") != f"{api}/issues/{number}"):
            raise AdmissionDenied("github-comment-incomplete")
        ids.add(comment["id"])
    for comment in sorted(comments, key=lambda row: row["id"], reverse=True):
        if not comment["body"].startswith(APPROVAL_MARKER):
            continue
        user_id, login = _user(comment.get("user"))
        permission = fetch_json(f"{api}/collaborators/{login}/permission")
        if not isinstance(permission, dict) or _user(permission.get("user")) != (user_id, login):
            raise AdmissionDenied("github-approver-unverifiable")
        if (permission.get("role_name"), permission.get("permission")) not in {("admin", "admin"), ("maintain", "write")}:
            continue
        created = _date(comment.get("created_at"))
        if created != _date(comment.get("updated_at")) or not _date(current["updated_at"]) <= created <= now():
            raise AdmissionDenied("github-approval-stale-or-edited")
        try:
            approval = json.loads(comment["body"][len(APPROVAL_MARKER):], object_pairs_hook=_json_object)
        except (ValueError, TypeError) as exc:
            raise AdmissionDenied("github-approval-invalid") from exc
        if (not isinstance(approval, dict) or set(approval) != {"action", "repository", "issue_number", "issue_id", "content_sha256", "expires_at"}
                or approval.get("action") != "approve" or approval.get("repository") != repo
                or type(approval.get("issue_number")) is not int or approval["issue_number"] != number
                or type(approval.get("issue_id")) is not int or approval["issue_id"] != current["id"]
                or approval.get("content_sha256") != digest):
            raise AdmissionDenied("github-approval-scope-mismatch")
        expires = _date(approval["expires_at"])
        if not now() < expires <= created + timedelta(seconds=MAX_APPROVAL_AGE):
            raise AdmissionDenied("github-approval-expired-or-unbounded")
        # A second complete read prevents pagination/permission checks from
        # silently consuming an issue revision that changed during admission.
        fresh = fetch_json(f"{api}/issues/{number}")
        if (issue_revision(repo, repository, fresh) != digest or fresh["updated_at"] != current["updated_at"]
                or fresh["comments"] != current["comments"]):
            raise AdmissionDenied("github-issue-changed-during-admission")
        return fresh, {"version": 1, "approval_id": comment["id"], "content_sha256": digest,
                       "repository_id": repository["id"], "issue_id": fresh["id"],
                       "approver_user_id": user_id, "approver_login": login,
                       "approved_at": comment["created_at"], "expires_at": approval["expires_at"],
                       "issue_updated_at": fresh["updated_at"]}
    raise AdmissionDenied("github-maintainer-approval-missing")


def used_approvals(value):
    history = value.get("used_approvals", {})
    if (not isinstance(history, dict) or len(history) > 1024
            or any(not isinstance(key, str) or not key.isdigit() or not isinstance(item, str)
                   or not re.fullmatch(r"github-[a-z0-9-]+-issue-[0-9]+-approval-[0-9]+", item)
                   for key, item in history.items())):
        raise AdmissionDenied("intake-approval-history-invalid")
    return dict(history)


def _atomic_json(path, data):
    fd, temporary = tempfile.mkstemp(prefix="." + path.name + ".", suffix=".tmp", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(json.dumps(data, ensure_ascii=False, indent=2) + "\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        _sync_directory(path.parent)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass

def _sync_directory(path):
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)

def scan_remaining():
    if _SCAN_DEADLINE is None:
        return GH_TIMEOUT_SECONDS
    remaining = _SCAN_DEADLINE - time.monotonic()
    if remaining <= 0:
        raise ScanExpired("intake-scan-deadline")
    return min(GH_TIMEOUT_SECONDS, remaining)

def _retained_admission(path, task_id, admission):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    try:
        s = os.fstat(fd)
        if not stat.S_ISREG(s.st_mode) or s.st_nlink != 1 or not 0 < s.st_size <= 1048576:
            raise AdmissionDenied("intake-admission-collision")
        chunks = []
        remaining = s.st_size
        while remaining:
            chunk = os.read(fd, min(remaining, 65536))
            if not chunk:
                raise AdmissionDenied("intake-admission-collision")
            remaining -= len(chunk)
            chunks.append(chunk)
        after = os.fstat(fd)
        if (s.st_dev, s.st_ino, s.st_size, s.st_mtime_ns, s.st_ctime_ns) != (
                after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns, after.st_ctime_ns):
            raise AdmissionDenied("intake-admission-collision")
        retained = json.loads(b"".join(chunks), object_pairs_hook=_json_object)
        if not isinstance(retained, dict) or retained.get("id") != task_id or retained.get("github_admission") != admission:
            raise AdmissionDenied("intake-admission-collision")
    except (ValueError, TypeError) as exc:
        raise AdmissionDenied("intake-admission-collision") from exc
    finally:
        os.close(fd)

def _rename_exclusive(directory_fd, source, target):
    libc = ctypes.CDLL(None, use_errno=True)
    rename = getattr(libc, "renameat2", None)
    if rename is None:
        raise AdmissionDenied("intake-exclusive-publication-unavailable")
    rename.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint]
    rename.restype = ctypes.c_int
    ctypes.set_errno(0)
    if rename(directory_fd, os.fsencode(source), directory_fd, os.fsencode(target), 1) != 0:
        code = ctypes.get_errno()
        raise OSError(code, os.strerror(code), target)

def publish_task(path, task, admission):
    # The dispatcher only sees a complete fsynced JSON, published without replace.
    directory_fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    temporary = None
    try:
        fd, temporary = tempfile.mkstemp(prefix=".intake-", suffix=".tmp", dir=path.parent)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(json.dumps(task, ensure_ascii=False, indent=2) + "\n")
            handle.flush()
            os.fsync(handle.fileno())
        try:
            _rename_exclusive(directory_fd, Path(temporary).name, path.name)
        except FileExistsError:
            _retained_admission(path, task["id"], admission)
        else:
            temporary = None
        os.fsync(directory_fd)  # Also make a verified post-crash collision durable.
    finally:
        if temporary is not None:
            try:
                os.unlink(temporary)
            except FileNotFoundError:
                pass
        os.close(directory_fd)

def _scan_cursor(consumers):
    path = STAMP.with_suffix(".cursor.json")
    if not path.exists():
        return path, {"version": 1, "next_repository": consumers[0]["repository"], "after_issue": {}}
    try:
        value = json.loads(path.read_bytes(), object_pairs_hook=_json_object)
    except (OSError, ValueError) as exc:
        raise AdmissionDenied("intake-cursor-invalid") from exc
    if (not isinstance(value, dict) or set(value) != {"version", "next_repository", "after_issue"}
            or value["version"] != 1 or not isinstance(value["next_repository"], str)
            or not SAFE_REPO.fullmatch(value["next_repository"])
            or not isinstance(value["after_issue"], dict)
            or any(not SAFE_REPO.fullmatch(k) or type(v) is not int or v <= 0
                   for k, v in value["after_issue"].items())):
        raise AdmissionDenied("intake-cursor-invalid")
    selected = {c["repository"] for c in consumers}
    value["after_issue"] = {repo: issue for repo, issue in value["after_issue"].items() if repo in selected}
    return path, value

def _scan_issue(consumer, issue, indexed, previous):
    number = int(issue["number"])
    repo = consumer["repository"]
    key = state_key(repo, number)
    records = indexed.get(key, [])
    active = [record for record in records if record["state"] in ACTIVE_DIRS]
    current = {"open": True, "consumer": consumer["consumer"], "repo": repo, "issue": number,
               "title": str(issue.get("title") or "")[:160],
               "remote_updated_at": str(issue.get("updated_at") or ""),
               "seen_at": now().isoformat(), "used_approvals": used_approvals(previous)}
    if 'admission_intent' in previous:
        current['admission_intent'] = previous['admission_intent']
    if _requires_admission_reconciliation(previous):
        current.update(scheduler_state='blocked', blocker='intake-admission-reconciliation-required')
        return key, current
    if active:
        current.update(scheduler_state="active", task_ids=[str(r["task"].get("id") or "") for r in active])
        return key, current
    blocker = intervention_blocker(records, allow_failed_replan=consumer.get("mode") == "root_only")
    if blocker:
        current.update(scheduler_state="blocked", task_id=blocker[0], blocker=blocker[1])
        return key, current
    terminal = next((r for r in records if r["state"] in TERMINAL_DIRS), None)
    if terminal and time.time() - terminal["mtime"] < COOLDOWN_SECONDS:
        current.update(scheduler_state="cooldown", task_id=str(terminal["task"].get("id") or ""))
        return key, current
    try:
        task_id = queue_issue(consumer, issue, records)
    except ScanExpired:
        raise
    except AdmissionDenied as exc:
        current.update(scheduler_state="unauthorized", blocker=str(exc))
        return key, current
    approval_id = task_id.rsplit("-approval-", 1)[1]
    replayed = approval_id in current["used_approvals"]
    durable = load_state().get(key, {})
    current["used_approvals"].update(used_approvals(durable))
    if 'admission_intent' in durable:
        current['admission_intent'] = durable['admission_intent']
    current["used_approvals"][approval_id] = task_id
    current.update(scheduler_state="admission_replayed" if replayed else "queued", task_id=task_id)
    return key, current

def _scan_intake_locked(consumers):
    global _SCAN_DEADLINE, _SCAN_USER
    previous_deadline, previous_user = _SCAN_DEADLINE, _SCAN_USER
    _SCAN_DEADLINE, _SCAN_USER = time.monotonic() + SCAN_SECONDS, None
    try:
        if len(consumers) > MAX_CONSUMERS:
            raise AdmissionDenied("intake-consumer-limit")
        previous = load_state()  # No history may be silently dropped before auth/work.
        previous, retired = _retire_unselected_consumers(previous, {c['repository'] for c in consumers})
        if retired:
            save_state(previous)
        if not consumers:
            return 0
        cursor_path, cursor = _scan_cursor(consumers)
        indexed = task_index()
        authenticated_user()
        new_state = dict(previous)
        repos = [c["repository"] for c in consumers]
        start = repos.index(cursor["next_repository"]) if cursor["next_repository"] in repos else 0
        ordered = consumers[start:] + consumers[:start]
        complete = True
        try:
            for consumer in ordered:
                scan_remaining()
                repo = consumer["repository"]
                cursor["next_repository"] = repos[(repos.index(repo) + 1) % len(repos)]
                _atomic_json(cursor_path, cursor)
                try:
                    issues = fetch_issues(consumer)
                except ScanExpired:
                    raise
                except AdmissionDenied as exc:
                    log(f"intake consumer deferred {repo}: {exc}")
                    complete = False
                    continue
                after = cursor["after_issue"].get(repo, 0)
                issues = sorted(issues, key=lambda i: (int(i["number"]) <= after, int(i["number"])))
                seen = set()
                for issue in issues:
                    scan_remaining()
                    cursor["after_issue"][repo] = int(issue["number"])
                    _atomic_json(cursor_path, cursor)  # Fairness only; never approval authority.
                    key = state_key(repo, issue["number"])
                    seen.add(key)
                    key, row = _scan_issue(consumer, issue, indexed, previous.get(key, {}))
                    new_state[key] = row
                for key, old in previous.items():
                    if old.get("repo") == repo and key not in seen:
                        row = dict(old)
                        row.update(open=False, seen_at=now().isoformat(), closed_or_missing=True,
                                   previous_task_id=old.get("task_id"), scheduler_state="closed")
                        row.pop("task_id", None)
                        row.pop("task_ids", None)
                        new_state[key] = row
        except ScanExpired:
            complete = False
            log("intake scan deferred at bounded deadline")
        save_state(_merge_durable_admissions(new_state))
        if complete:
            STAMP.touch()
            os.chmod(STAMP, 0o600)
        return 0
    finally:
        _SCAN_DEADLINE, _SCAN_USER = previous_deadline, previous_user


@contextlib.contextmanager
def intake_lock():
    global _INTAKE_LOCK_OWNER
    owner = os.getpid()
    if _INTAKE_LOCK_OWNER == owner:
        yield
        return
    fd = os.open(STATE.with_suffix('.lock'), os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) != 0o600:
            raise AdmissionDenied('intake-lock-invalid')
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise AdmissionDenied('intake-already-running') from exc
        _INTAKE_LOCK_OWNER = owner
        try:
            yield
        finally:
            _INTAKE_LOCK_OWNER = None
            fcntl.flock(fd, fcntl.LOCK_UN)
    finally:
        os.close(fd)


def _validate_admission_intent(row, history):
    intent = row.get('admission_intent')
    if intent is None and 'admission_intent' not in row:
        return
    if (not isinstance(intent, dict) or set(intent) != {'version', 'approval_id', 'task_id', 'content_sha256', 'state'}
            or type(intent['version']) is not int or intent['version'] != 1
            or type(intent['approval_id']) is not int or intent['approval_id'] <= 0
            or not isinstance(intent['task_id'], str)
            or history.get(str(intent['approval_id'])) != intent['task_id']
            or not intent['task_id'].endswith('-approval-' + str(intent['approval_id']))
            or not isinstance(intent['content_sha256'], str) or not re.fullmatch('[0-9a-f]{64}', intent['content_sha256'])
            or intent['state'] not in {'publication_pending', 'published'}):
        raise AdmissionDenied('intake-admission-intent-invalid')


def _requires_admission_reconciliation(row):
    intent = row.get('admission_intent')
    return isinstance(intent, dict) and intent['state'] == 'publication_pending'


def _consume_admission(consumer, issue, task_id, admission):
    if _INTAKE_LOCK_OWNER != os.getpid():
        raise AdmissionDenied('intake-lock-required')
    state = load_state()
    key = state_key(consumer['repository'], issue['number'])
    row = dict(state.get(key, {}))
    if _requires_admission_reconciliation(row):
        raise AdmissionDenied('intake-admission-reconciliation-required')
    history = used_approvals(row)
    approval_id = str(admission['approval_id'])
    if approval_id in history or len(history) >= 1024:
        raise AdmissionDenied('intake-admission-already-consumed')
    history[approval_id] = task_id
    row.update(repo=consumer['repository'], issue=issue['number'], consumer=consumer['consumer'],
               open=True, seen_at=now().isoformat(), used_approvals=history,
               task_id=task_id, scheduler_state='blocked', blocker='intake-admission-reconciliation-required',
               admission_intent={'version': 1, 'approval_id': admission['approval_id'], 'task_id': task_id,
                                 'content_sha256': admission['content_sha256'], 'state': 'publication_pending'})
    state[key] = row
    # Complete STATE file AND its directory must be durable before queue exposure.
    save_state(state)


def _mark_admission_published(consumer, issue, task_id, admission):
    if _INTAKE_LOCK_OWNER != os.getpid():
        raise AdmissionDenied('intake-lock-required')
    state = load_state()
    key = state_key(consumer['repository'], issue['number'])
    row = dict(state[key])
    intent = row['admission_intent']
    if intent != {'version': 1, 'approval_id': admission['approval_id'], 'task_id': task_id,
                  'content_sha256': admission['content_sha256'], 'state': 'publication_pending'}:
        raise AdmissionDenied('intake-admission-intent-changed')
    row['admission_intent'] = {**intent, 'state': 'published'}
    row['scheduler_state'] = 'queued'
    row.pop('blocker', None)
    state[key] = row
    save_state(state)


def _retire_unselected_consumers(state, selected):
    result = dict(state)
    changed = False
    for key, old in state.items():
        if old['repo'] not in selected:
            row = dict(old)
            row.update(open=False, closed_or_missing=True, retired_consumer=True, scheduler_state='closed')
            if 'task_id' in row:
                row['previous_task_id'] = row.pop('task_id')
            if 'task_ids' in row:
                row['previous_task_ids'] = row.pop('task_ids')
            result[key] = row
            changed |= row != old
    return result, changed


def _merge_durable_admissions(state):
    # queue_issue persists intents during this same locked scan. A final scan
    # snapshot must not erase them with its earlier in-memory history copy.
    for key, durable in load_state().items():
        row = dict(state.get(key, durable))
        history = used_approvals(row)
        for approval, task_id in used_approvals(durable).items():
            if approval in history and history[approval] != task_id:
                raise AdmissionDenied('intake-admission-history-conflict')
            history[approval] = task_id
        row['used_approvals'] = history
        if 'admission_intent' in durable:
            row['admission_intent'] = durable['admission_intent']
        state[key] = row
    return state


def queue_issue(consumer, issue, records):
    with intake_lock():
        return _queue_issue_locked(consumer, issue, records)


def scan_intake(consumers):
    with intake_lock():
        return _scan_intake_locked(consumers)



def fetch_issues(consumer: dict) -> list[dict]:
    repo = consumer["repository"]
    mode = consumer["mode"]
    if mode == "root_only":
        number = int(consumer["root_issue"])
        issue = fetch_json(f"https://api.github.com/repos/{repo}/issues/{number}")
        if not isinstance(issue, dict):
            raise RuntimeError(f"invalid root issue response for {repo}#{number}")
        if issue.get("number") != number or "pull_request" in issue:
            raise RuntimeError(f"mismatched root issue response for {repo}#{number}")
        state = issue.get("state")
        if state == "closed":
            return []
        if state != "open":
            raise RuntimeError(f"invalid root issue state for {repo}#{number}")
        return [issue]

    issues = fetch_json(f"https://api.github.com/repos/{repo}/issues?state=open&per_page=100")
    if not isinstance(issues, list):
        raise RuntimeError(f"invalid GitHub issue response for {repo}")
    return [
        issue
        for issue in issues
        if isinstance(issue, dict) and "pull_request" not in issue
    ]


def task_index() -> dict[str, list[dict]]:
    by_identity: dict[str, list[dict]] = defaultdict(list)
    for state_name in (*ACTIVE_DIRS, *TERMINAL_DIRS):
        directory = ROOT / state_name
        for path in directory.glob("*.json"):
            try:
                data = json.loads(path.read_text(encoding="utf-8"))
                issue = data.get("issue")
                if isinstance(issue, int) or (
                    isinstance(issue, str) and issue.isdigit()
                ):
                    key = state_key(task_repo(data), issue)
                    by_identity[key].append(
                        {
                            "state": state_name,
                            "path": path,
                            "task": data,
                            "mtime": path.stat().st_mtime,
                        }
                    )
            except Exception as exc:
                log(f"task index skip {path.name}: {exc}")
    for records in by_identity.values():
        records.sort(key=lambda item: item["mtime"], reverse=True)
    return by_identity


def result_for(task_id: str) -> dict:
    path = RESULTS / f"{task_id}.json"
    if not path.exists():
        return {}
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return {}


def prior_evidence(records: list[dict]) -> str:
    for record in records:
        task = record["task"]
        task_id = str(task.get("id") or "")
        result = result_for(task_id)
        if result:
            compact = {
                "previous_task": task_id,
                "previous_state": record["state"],
                "summary": result.get("summary"),
                "blocker": result.get("blocker"),
                "next_action": result.get("next_action"),
            }
            return json.dumps(compact, ensure_ascii=False)[:5000]
        if record["state"] == "failed":
            last_error = task.get("last_error")
            if isinstance(last_error, str) and last_error.strip():
                compact = {
                    "previous_task": task_id,
                    "previous_state": "failed",
                    "summary": None,
                    "blocker": None,
                    "next_action": None,
                    "last_error": last_error.strip()[:2000],
                }
                return json.dumps(compact, ensure_ascii=False)[:5000]
    return "none"


def issue_priority(consumer: dict, issue: dict) -> int:
    default = int(consumer.get("priority_default", 60))
    if consumer.get("mode") == "root_only":
        return default
    title = str(issue.get("title") or "").strip().lower()
    if title.startswith("roadmap:"):
        return max(default, 90)
    if "architecture" in title or "architektura" in title:
        return int(consumer.get("priority_architecture", 50))
    return default


